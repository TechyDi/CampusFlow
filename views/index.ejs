<%- include('partials/header') %>

<div class="max-w-6xl mx-auto px-6 py-16 text-center fade-in">
    <h1 class="text-5xl font-extrabold text-gray-900 mb-6 tracking-tight">Welcome to <span class="text-blue-600">CampusFlow</span></h1>
    <p class="text-xl text-gray-600 mb-12 max-w-2xl mx-auto">
        Your all-in-one platform for smart campus management. 
        Select a module below to get started.
    </p>
    <div class="mt-4 mb-8">
        <% if (!locals.user) { %>
            <a href="/onboarding" class="inline-block relative group cursor-pointer">
                <div class="absolute -inset-1 bg-gradient-to-r from-blue-500 to-blue-600 rounded-lg blur opacity-25 group-hover:opacity-100 transition duration-1000 group-hover:duration-200"></div>
                <button class="relative bg-white ring-1 ring-gray-900/5 leading-none flex items-center justify-center space-x-2 px-8 py-4 bg-gradient-to-r from-blue-600 to-blue-700 rounded-lg shadow-xl hover:shadow-2xl hover:scale-105 transition-all transform duration-300">
                    <span class="text-white font-black text-lg tracking-wide uppercase">Register Your Institution</span>
                    <svg class="w-6 h-6 text-white ml-2 animate-bounce" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M13 7l5 5m0 0l-5 5m5-5H6"></path></svg>
                </button>
            </a>
        <% } %>
    </div>
    
    <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6 text-left mt-8">
        
        <!-- Smart Attendance (Phase 8 Focus) -->
        <% if (!locals.user || (locals.user && (locals.user.role === 'STUDENT' || locals.user.role === 'FACULTY'))) { %>
            <a href="/attendance" class="block bg-gradient-to-br from-pink-500 to-rose-600 p-8 rounded-2xl shadow-md hover:shadow-xl hover:-translate-y-1 transition transform duration-300 relative overflow-hidden group">
                <div class="absolute top-0 right-0 p-4 opacity-20 group-hover:opacity-30 transition">
                    <svg class="w-24 h-24 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 11c0 3.517-1.009 6.799-2.753 9.571m-3.44-2.04l.054-.09A13.916 13.916 0 008 11a4 4 0 118 0c0 1.017-.071 2.019-.203 3m-2.118 6.844A21.88 21.88 0 0015.171 17m3.839 1.132c.645-2.266.99-4.659.99-7.132A8 8 0 008 4.07M3 15.364c.64-1.319 1-2.8 1-4.364 0-1.457.39-2.823 1.07-4"></path></svg>
                </div>
                <div class="relative z-10">
                    <span class="inline-block bg-yellow-400 text-yellow-900 text-xs font-bold px-2 py-1 rounded-full uppercase tracking-wider mb-3 shadow-sm">New Feature</span>
                    <h3 class="text-2xl font-bold text-white mb-2">Smart Attendance</h3>
                    <p class="text-pink-100 text-sm mb-4">Location-based check-in using QR codes or class pins.</p>
                    <span class="text-white font-semibold flex items-center">Check In Now <svg class="w-4 h-4 ml-1" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path></svg></span>
                </div>
            </a>
        <% } %>

        <!-- CMMS / Complaints -->
        <% if (!locals.user || (locals.user && (locals.user.role === 'STUDENT' || locals.user.role === 'STAFF' || locals.user.role === 'WARDEN' || locals.user.role === 'FACULTY'))) { %>
            <a href="/complaints" class="block bg-gradient-to-br from-blue-500 to-blue-700 p-8 rounded-2xl shadow-md hover:shadow-xl hover:-translate-y-1 transition transform duration-300 relative overflow-hidden group">
                <div class="absolute top-0 right-0 p-4 opacity-20 group-hover:opacity-30 transition">
                    <svg class="w-24 h-24 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 002-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10"></path></svg>
                </div>
                <div class="relative z-10">
                    <h3 class="text-2xl font-bold text-white mb-2">Maintenance Hub</h3>
                    <p class="text-blue-100 text-sm mb-4">Report and track hostel/facility issues in real-time.</p>
                    <span class="text-white font-semibold flex items-center">Report Issue <svg class="w-4 h-4 ml-1" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path></svg></span>
                </div>
            </a>
        <% } %>

        <!-- Marketplace -->
        <% if (!locals.user || (locals.user && locals.user.role === 'STUDENT')) { %>
            <% if (!locals.user || locals.subscriptionPlan === 'PRO' || locals.subscriptionPlan === 'ENTERPRISE') { %>
                <a href="/marketplace" class="block bg-gradient-to-br from-green-500 to-emerald-600 p-8 rounded-2xl shadow-md hover:shadow-xl hover:-translate-y-1 transition transform duration-300 relative overflow-hidden group">
                    <div class="absolute top-0 right-0 p-4 opacity-20 group-hover:opacity-30 transition">
                        <svg class="w-24 h-24 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z"></path></svg>
                    </div>
                    <div class="relative z-10">
                        <h3 class="text-2xl font-bold text-white mb-2">Campus Marketplace</h3>
                        <p class="text-green-100 text-sm mb-4">Buy, sell, and trade items exclusively with peers.</p>
                        <span class="text-white font-semibold flex items-center">Browse Items <svg class="w-4 h-4 ml-1" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path></svg></span>
                    </div>
                </a>
            <% } %>
        <% } %>

        <!-- Lost & Found -->
        <% if (!locals.user || (locals.user && locals.user.role === 'STUDENT')) { %>
            <% if (!locals.user || locals.subscriptionPlan === 'PRO' || locals.subscriptionPlan === 'ENTERPRISE') { %>
                <a href="/lost-and-found" class="block bg-gradient-to-br from-orange-400 to-amber-500 p-8 rounded-2xl shadow-md hover:shadow-xl hover:-translate-y-1 transition transform duration-300 relative overflow-hidden group">
                    <div class="absolute top-0 right-0 p-4 opacity-20 group-hover:opacity-30 transition">
                        <svg class="w-24 h-24 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path></svg>
                    </div>
                    <div class="relative z-10">
                        <h3 class="text-2xl font-bold text-white mb-2">Lost & Found</h3>
                        <p class="text-orange-100 text-sm mb-4">Recover lost items or help others find their belongings.</p>
                        <span class="text-white font-semibold flex items-center">Find Items <svg class="w-4 h-4 ml-1" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path></svg></span>
                    </div>
                </a>
            <% } %>
        <% } %>

        <!-- Virtual Queues -->
        <% if (!locals.user || (locals.user && locals.user.role === 'STUDENT')) { %>
            <% if (!locals.user || locals.subscriptionPlan === 'ENTERPRISE') { %>
                <a href="/queues" class="block bg-gradient-to-br from-purple-500 to-fuchsia-600 p-8 rounded-2xl shadow-md hover:shadow-xl hover:-translate-y-1 transition transform duration-300 relative overflow-hidden group">
                    <div class="absolute top-0 right-0 p-4 opacity-20 group-hover:opacity-30 transition">
                        <svg class="w-24 h-24 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z"></path></svg>
                    </div>
                    <div class="relative z-10">
                        <h3 class="text-2xl font-bold text-white mb-2">Virtual Queues</h3>
                        <p class="text-purple-100 text-sm mb-4">Join queues for services digitally without standing in line.</p>
                        <span class="text-white font-semibold flex items-center">Join Queue <svg class="w-4 h-4 ml-1" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path></svg></span>
                    </div>
                </a>
            <% } %>
        <% } %>

        <!-- Announcements -->
        <% if (!locals.user || (locals.user && locals.user.role !== 'SUPER_ADMIN')) { %>
            <% if (!locals.user || locals.subscriptionPlan === 'PRO' || locals.subscriptionPlan === 'ENTERPRISE') { %>
                <a href="/announcements" class="block bg-gradient-to-br from-teal-500 to-cyan-600 p-8 rounded-2xl shadow-md hover:shadow-xl hover:-translate-y-1 transition transform duration-300 relative overflow-hidden group">
                    <div class="absolute top-0 right-0 p-4 opacity-20 group-hover:opacity-30 transition">
                        <svg class="w-24 h-24 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5.882V19.24a1.76 1.76 0 01-3.417.592l-2.147-6.15M18 13a3 3 0 100-6M5.436 13.683A4.001 4.001 0 017 6h1.832c4.1 0 7.625-1.234 9.168-3v14c-1.543-1.766-5.067-3-9.168-3H7a3.988 3.988 0 01-1.564-.317z"></path></svg>
                    </div>
                    <div class="relative z-10">
                        <h3 class="text-2xl font-bold text-white mb-2">Announcements</h3>
                        <p class="text-teal-100 text-sm mb-4">Stay updated with the latest news from your institution.</p>
                        <span class="text-white font-semibold flex items-center">View News <svg class="w-4 h-4 ml-1" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path></svg></span>
                    </div>
                </a>
            <% } %>
        <% } %>

    </div>
</div>

<%- include('partials/footer') %>
