<%- include('partials/header') %>

<div class="max-w-7xl mx-auto px-6 py-8 fade-in">
    <div class="flex justify-between items-center mb-8">
        <h2 class="text-3xl font-extrabold text-gray-900">Faculty Dashboard</h2>
    </div>

    <div class="grid lg:grid-cols-3 gap-8">
        <!-- Courses Management -->
        <div class="lg:col-span-1 space-y-6">
            <div class="bg-white p-6 rounded-2xl shadow-md hover:shadow-lg transition-shadow duration-300 border border-gray-100">
                <h3 class="text-xl font-bold text-gray-800 mb-4">Create New Course</h3>
                <form id="createCourseForm" class="space-y-4">
                    <div>
                        <label class="block text-sm font-medium text-gray-700 mb-1">Course Code</label>
                        <input type="text" id="courseCode" required placeholder="e.g. CS101" class="w-full border border-gray-300 rounded-md px-3 py-2 focus:ring-blue-500 focus:border-blue-500 uppercase">
                    </div>
                    <div>
                        <label class="block text-sm font-medium text-gray-700 mb-1">Course Name</label>
                        <input type="text" id="courseName" required placeholder="e.g. Intro to Programming" class="w-full border border-gray-300 rounded-md px-3 py-2 focus:ring-blue-500 focus:border-blue-500">
                    </div>
                    <button type="submit" class="w-full bg-blue-600 hover:bg-blue-700 text-white font-bold py-2 px-4 rounded-md transition shadow-sm">
                        Add Course
                    </button>
                </form>
            </div>

            <div class="bg-white p-6 rounded-2xl shadow-md hover:shadow-lg transition-shadow duration-300 border border-gray-100">
                <h3 class="text-xl font-bold text-gray-800 mb-4">My Courses</h3>
                <% if (courses.length === 0) { %>
                    <p class="text-sm text-gray-500 italic">No courses found. Create one above.</p>
                <% } else { %>
                    <ul class="space-y-3">
                        <% courses.forEach(course => { %>
                            <li class="p-3 border border-gray-100 bg-gray-50 rounded-lg flex justify-between items-center">
                                <div>
                                    <span class="font-bold text-gray-900 block"><%= course.code %></span>
                                    <span class="text-xs text-gray-500"><%= course.name %></span>
                                </div>
                                <button onclick="openStartSessionModal('<%= course.id %>', '<%= course.code %>')" class="text-xs bg-blue-100 text-blue-700 px-3 py-1.5 rounded-full font-bold hover:bg-indigo-200 transition">
                                    Start Session
                                </button>
                            </li>
                        <% }) %>
                    </ul>
                <% } %>
            </div>
        </div>

        <!-- Attendance Sessions -->
        <div class="lg:col-span-2">
            <div class="bg-white rounded-2xl shadow-md hover:shadow-lg transition-shadow duration-300 border border-gray-100 overflow-hidden">
                <div class="px-6 py-5 border-b border-gray-100 bg-gray-50 flex justify-between items-center">
                    <h3 class="text-lg font-bold text-gray-800">Attendance Sessions</h3>
                </div>
                
                <div class="overflow-x-auto">
                    <table class="min-w-full divide-y divide-gray-200">
                        <thead class="bg-gray-50">
                            <tr>
                                <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Course</th>
                                <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Date/Time</th>
                                <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Code</th>
                                <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Status</th>
                                <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Action</th>
                            </tr>
                        </thead>
                        <tbody class="bg-white divide-y divide-gray-200">
                            <% 
                            let allSessions = [];
                            courses.forEach(c => {
                                c.sessions.forEach(s => {
                                    allSessions.push({ ...s, course: c });
                                });
                            });
                            allSessions.sort((a,b) => new Date(b.date) - new Date(a.date));
                            %>
                            <% if (allSessions.length === 0) { %>
                                <tr>
                                    <td colspan="5" class="px-6 py-8 text-center text-sm text-gray-500">No sessions recorded yet.</td>
                                </tr>
                            <% } else { %>
                                <% allSessions.forEach(session => { %>
                                    <tr>
                                        <td class="px-6 py-4 whitespace-nowrap">
                                            <div class="text-sm font-bold text-gray-900"><%= session.course.code %></div>
                                        </td>
                                        <td class="px-6 py-4 whitespace-nowrap">
                                            <div class="text-sm text-gray-900"><%= new Date(session.date).toLocaleDateString() %></div>
                                            <div class="text-xs text-gray-500"><%= new Date(session.date).toLocaleTimeString() %></div>
                                        </td>
                                        <td class="px-6 py-4 whitespace-nowrap">
                                            <span class="font-mono text-lg font-bold text-blue-600 bg-blue-50 px-2 py-1 rounded border border-blue-100">
                                                <%= session.checkInCode %>
                                            </span>
                                        </td>
                                        <td class="px-6 py-4 whitespace-nowrap">
                                            <% 
                                            let isExpired = session.expiresAt && new Date(session.expiresAt) < new Date();
                                            if (session.isActive && !isExpired) { 
                                            %>
                                                <span class="px-2 py-1 inline-flex text-xs leading-5 font-semibold rounded-full bg-green-100 text-green-800">
                                                    Live
                                                </span>
                                            <% } else if (isExpired && session.isActive) { %>
                                                <span class="px-2 py-1 inline-flex text-xs leading-5 font-semibold rounded-full bg-yellow-100 text-yellow-800">
                                                    Expired
                                                </span>
                                            <% } else { %>
                                                <span class="px-2 py-1 inline-flex text-xs leading-5 font-semibold rounded-full bg-gray-100 text-gray-800">
                                                    Closed
                                                </span>
                                            <% } %>
                                        </td>
                                        <td class="px-6 py-4 whitespace-nowrap text-sm font-medium">
                                            <button onclick="viewAttendance('<%= session.id %>')" class="text-blue-600 hover:text-blue-900 mr-3">View List (<%= session._count.records %>)</button>
                                            <% if (session.isActive && !isExpired) { %>
                                                <button onclick="stopSession('<%= session.id %>')" class="text-red-600 hover:text-red-900">Stop</button>
                                            <% } %>
                                        </td>
                                    </tr>
                                <% }) %>
                            <% } %>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Start Session Modal -->
<div id="startSessionModal" class="fixed inset-0 bg-gray-900 bg-opacity-50 hidden z-50 flex items-center justify-center fade-in">
    <div class="bg-white rounded-xl shadow-2xl max-w-md w-full mx-4 overflow-hidden">
        <div class="px-6 py-4 border-b border-gray-100 flex justify-between items-center bg-gray-50">
            <h3 class="text-lg font-bold text-gray-800">Start Session: <span id="modalCourseCode" class="text-blue-600"></span></h3>
            <button onclick="closeStartSessionModal()" class="text-gray-400 hover:text-gray-600">
                <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path></svg>
            </button>
        </div>
        <div class="p-6">
            <p class="text-sm text-gray-600 mb-4">Starting a session will generate a check-in code. We need your current GPS location to enforce geofenced attendance.</p>
            
            <div class="mb-4">
                <label class="block text-sm font-medium text-gray-700 mb-1">Session Duration</label>
                <select id="sessionDuration" class="w-full border border-gray-300 rounded-md px-3 py-2 focus:ring-blue-500 focus:border-blue-500">
                    <option value="">No Expiry (Manual Stop)</option>
                    <option value="15">15 Minutes</option>
                    <option value="30">30 Minutes</option>
                    <option value="45">45 Minutes</option>
                    <option value="60">1 Hour</option>
                    <option value="90">1.5 Hours</option>
                    <option value="120">2 Hours</option>
                </select>
            </div>

            <div id="modalLocationStatus" class="mb-4 text-sm font-bold text-gray-700 bg-gray-50 p-3 rounded-md border border-gray-200">
                Location: Pending...
            </div>

            <button id="modalStartBtn" class="w-full bg-blue-600 hover:bg-blue-700 text-white font-bold py-3 px-4 rounded-md transition shadow-md flex justify-center items-center" onclick="confirmStartSession()">
                Acquire Location & Start
            </button>
        </div>
    </div>
</div>

<!-- View Attendance Modal -->
<div id="viewAttendanceModal" class="fixed inset-0 bg-gray-900 bg-opacity-50 hidden z-50 flex flex-col items-center justify-center p-4 fade-in">
    <div class="bg-white rounded-xl shadow-2xl max-w-2xl w-full flex flex-col max-h-full">
        <div class="px-6 py-4 border-b border-gray-100 flex justify-between items-center bg-gray-50">
            <h3 class="text-lg font-bold text-gray-800">Attendance Sheet</h3>
            <button onclick="document.getElementById('viewAttendanceModal').classList.add('hidden')" class="text-gray-400 hover:text-gray-600">
                <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path></svg>
            </button>
        </div>
        <div class="p-0 overflow-y-auto flex-1">
            <table class="min-w-full divide-y divide-gray-200">
                <thead class="bg-gray-50 sticky top-0">
                    <tr>
                        <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Student Name</th>
                        <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Email</th>
                        <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Check-in Time</th>
                    </tr>
                </thead>
                <tbody id="attendanceRecordsBody" class="bg-white divide-y divide-gray-200">
                    <!-- Records injected here -->
                </tbody>
            </table>
        </div>
    </div>
</div>

<script>
    document.getElementById('createCourseForm').addEventListener('submit', async (e) => {
        e.preventDefault();
        const code = document.getElementById('courseCode').value.trim();
        const name = document.getElementById('courseName').value.trim();
        
        try {
            const res = await fetch('/api/faculty/courses', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ code, name })
            });
            if (res.ok) {
                window.location.reload();
            } else {
                alert('Failed to create course');
            }
        } catch(err) {
            console.error(err);
        }
    });

    let currentSessionCourseId = null;

    function openStartSessionModal(courseId, courseCode) {
        currentSessionCourseId = courseId;
        document.getElementById('modalCourseCode').textContent = courseCode;
        document.getElementById('modalLocationStatus').textContent = "Location: Ready to acquire";
        document.getElementById('modalStartBtn').disabled = false;
        document.getElementById('modalStartBtn').textContent = "Acquire Location & Start";
        document.getElementById('startSessionModal').classList.remove('hidden');
    }

    function closeStartSessionModal() {
        document.getElementById('startSessionModal').classList.add('hidden');
        currentSessionCourseId = null;
    }

    function confirmStartSession() {
        const btn = document.getElementById('modalStartBtn');
        const statusDiv = document.getElementById('modalLocationStatus');
        
        btn.disabled = true;
        btn.textContent = "Getting Location...";
        statusDiv.textContent = "Location: Acquiring GPS signal...";

        if (!navigator.geolocation) {
            statusDiv.textContent = "Location: Geolocation not supported by browser.";
            btn.textContent = "Start without Location (Not Recommended)";
            btn.onclick = () => sendStartSessionReq(null, null);
            btn.disabled = false;
            return;
        }

        navigator.geolocation.getCurrentPosition(
            (position) => {
                const lat = position.coords.latitude;
                const lng = position.coords.longitude;
                statusDiv.innerHTML = `Location: <span class="text-green-600">Acquired (${lat.toFixed(4)}, ${lng.toFixed(4)})</span>`;
                btn.textContent = "Starting...";
                sendStartSessionReq(lat, lng);
            },
            (err) => {
                statusDiv.innerHTML = `<span class="text-red-600">Location Error: ${err.message}</span>`;
                btn.textContent = "Start without Location (Not Recommended)";
                btn.onclick = () => sendStartSessionReq(null, null);
                btn.disabled = false;
            },
            { enableHighAccuracy: true, timeout: 10000, maximumAge: 0 }
        );
    }

    async function sendStartSessionReq(lat, lng) {
        const durationMinutes = document.getElementById('sessionDuration').value;
        try {
            const res = await fetch('/api/faculty/sessions', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ courseId: currentSessionCourseId, latitude: lat, longitude: lng, durationMinutes })
            });
            if (res.ok) {
                window.location.reload();
            } else {
                const data = await res.json();
                alert('Error: ' + data.error);
                document.getElementById('modalStartBtn').disabled = false;
                document.getElementById('modalStartBtn').textContent = "Try Again";
            }
        } catch (e) {
            console.error(e);
        }
    }

    async function stopSession(id) {
        if (!confirm('Are you sure you want to close this attendance session? Students will no longer be able to check in.')) return;
        try {
            const res = await fetch(`/api/faculty/sessions/${id}/stop`, { method: 'PUT' });
            if (res.ok) {
                window.location.reload();
            }
        } catch (e) {
            console.error(e);
        }
    }

    async function viewAttendance(id) {
        try {
            const res = await fetch(`/api/faculty/sessions/${id}/attendance`);
            const data = await res.json();
            if (data.success) {
                const tbody = document.getElementById('attendanceRecordsBody');
                tbody.innerHTML = '';
                
                if (data.session.records.length === 0) {
                    tbody.innerHTML = '<tr><td colspan="3" class="px-6 py-4 text-center text-sm text-gray-500">No students checked in.</td></tr>';
                } else {
                    data.session.records.forEach(record => {
                        const tr = document.createElement('tr');
                        tr.innerHTML = `
                            <td class="px-6 py-4 whitespace-nowrap text-sm font-bold text-gray-900">${record.student.name}</td>
                            <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">${record.student.email}</td>
                            <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">${new Date(record.timestamp).toLocaleTimeString()}</td>
                        `;
                        tbody.appendChild(tr);
                    });
                }
                document.getElementById('viewAttendanceModal').classList.remove('hidden');
            }
        } catch (e) {
            console.error(e);
        }
    }
</script>

</body>
</html>
