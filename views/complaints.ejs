<%- include('partials/header') %>

<div class="max-w-6xl mx-auto px-6 py-10 fade-in">
    <div class="flex justify-between items-end mb-8">
        <div>
            <h2 class="text-3xl font-bold text-gray-900">Complaint Management</h2>
            <p class="text-gray-600 mt-2">Submit and track maintenance requests.</p>
        </div>
        <!-- Client-side DOM filtering (Level 2) -->
        <div>
            <label for="statusFilter" class="block text-sm font-medium text-gray-700 mb-1">Filter by Status:</label>
            <select id="statusFilter" class="border border-gray-300 rounded-md px-3 py-2 text-sm focus:ring-blue-500 focus:border-blue-500">
                <option value="All">All</option>
                <option value="Open">Open</option>
                <option value="Resolved">Resolved</option>
            </select>
        </div>
    </div>

    <div class="grid md:grid-cols-3 gap-8">
        <!-- Submission Form -->
        <div class="md:col-span-1 bg-white p-6 rounded-2xl shadow-md border border-gray-100">
            <h3 class="text-xl font-bold mb-4">New Request</h3>
            
            <% if (locals.errors && locals.errors.length > 0) { %>
                <div class="bg-red-50 text-red-700 p-3 rounded-md mb-4 text-sm border border-red-200">
                    <ul class="list-disc pl-5">
                        <% locals.errors.forEach(err => { %>
                            <li><%= err %></li>
                        <% }) %>
                    </ul>
                </div>
            <% } %>

            <form id="complaintForm" class="space-y-4">
                <div>
                    <label class="block text-sm font-medium text-gray-700 mb-1">Title</label>
                    <input type="text" name="title" id="title" class="w-full border border-gray-300 rounded-md px-3 py-2 focus:ring-blue-500 focus:border-blue-500 text-sm transition" placeholder="e.g., AC not working">
                    <p id="titleError" class="text-red-500 text-xs mt-1 hidden">Title is required (min 5 chars).</p>
                </div>
                <div>
                    <div class="flex items-center space-x-2 bg-purple-50 border border-purple-200 rounded-md px-4 py-3 mb-4">
                        <svg class="w-5 h-5 text-purple-600" fill="currentColor" viewBox="0 0 20 20">
                            <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm1-11a1 1 0 10-2 0v2H7a1 1 0 100 2h2v2a1 1 0 102 0v-2h2a1 1 0 100-2h-2V7z" clip-rule="evenodd" />
                        </svg>
                        <p class="text-sm text-purple-800 font-medium">Google Gemini AI will automatically categorize this issue based on your description.</p>
                    </div>
                </div>
                <div class="grid grid-cols-2 gap-4">
                    <div>
                        <label class="block text-sm font-medium text-gray-700 mb-1">Building/Campus</label>
                        <select name="buildingId" id="buildingId" class="w-full border border-gray-300 rounded-md px-3 py-2 focus:ring-blue-500 focus:border-blue-500 text-sm transition">
                            <% buildings.forEach(b => { %>
                                <option value="<%= b.id %>"><%= b.name %></option>
                            <% }) %>
                        </select>
                    </div>
                    <div>
                        <label class="block text-sm font-medium text-gray-700 mb-1">Room/Location (Optional)</label>
                        <input type="text" name="room" id="room" class="w-full border border-gray-300 rounded-md px-3 py-2 focus:ring-blue-500 focus:border-blue-500 text-sm transition" placeholder="e.g., Room 204">
                    </div>
                </div>
                <div>
                    <label class="block text-sm font-medium text-gray-700 mb-1">Description</label>
                    <textarea name="description" id="description" rows="3" class="w-full border border-gray-300 rounded-md px-3 py-2 focus:ring-blue-500 focus:border-blue-500 text-sm transition"></textarea>
                </div>
                <button type="submit" id="submitBtn" class="w-full bg-blue-600 text-white font-medium py-2 rounded-md hover:bg-blue-700 transition flex justify-center items-center">
                    <span id="btnText">Submit Request</span>
                    <svg id="btnSpinner" class="animate-spin ml-2 h-5 w-5 text-white hidden" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
                        <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                        <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
                    </svg>
                </button>
            </form>
        </div>

        <!-- Complaints List -->
        <div class="md:col-span-2">
            <div class="bg-white rounded-2xl shadow-md border border-gray-100 overflow-hidden">
                <div class="overflow-x-auto">
                    <table class="min-w-full divide-y divide-gray-200" id="complaintsTable">
                        <thead class="bg-gray-50">
                        <tr>
                            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">ID / Title</th>
                            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Category</th>
                            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Location</th>
                            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Status</th>
                            <th class="px-6 py-3 text-right text-xs font-medium text-gray-500 uppercase tracking-wider">Action</th>
                        </tr>
                    </thead>
                    <tbody class="bg-white divide-y divide-gray-200">
                        <% if(complaints.length === 0) { %>
                            <tr>
                                <td colspan="5" class="px-6 py-4 text-center text-gray-500">No complaints found.</td>
                            </tr>
                        <% } else { %>
                            <% complaints.reverse().forEach(c => { %>
                                <tr class="complaint-row" data-status="<%= c.status %>" id="row-<%= c.fullId %>">
                                    <td class="px-6 py-4">
                                        <div class="text-sm font-medium text-gray-900">#<%= c.id %> <%= c.title %></div>
                                        <div class="text-xs text-gray-500"><%= c.createdAt.toLocaleString() %></div>
                                    </td>
                                    <td class="px-6 py-4 whitespace-nowrap">
                                        <span class="px-2 inline-flex text-xs leading-5 font-semibold rounded-full bg-purple-100 text-purple-800">
                                            <%= c.category %>
                                        </span>
                                    </td>
                                    <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">
                                        <%= c.building %> <%= c.roomNumber ? '- ' + c.roomNumber : '' %>
                                    </td>
                                    <td class="px-6 py-4 whitespace-nowrap">
                                        <% if(c.status === 'OPEN') { %>
                                            <span class="px-2 inline-flex text-xs leading-5 font-semibold rounded-full bg-yellow-100 text-yellow-800">Open</span>
                                        <% } else if(c.status === 'PENDING_VERIFICATION') { %>
                                            <span class="px-2 inline-flex text-xs leading-5 font-semibold rounded-full bg-blue-100 text-blue-800">Under Review</span>
                                        <% } else { %>
                                            <span class="px-2 inline-flex text-xs leading-5 font-semibold rounded-full bg-green-100 text-green-800"><%= c.status %></span>
                                        <% } %>
                                    </td>
                                    <td class="px-6 py-4 whitespace-nowrap text-right text-sm font-medium">
                                        <% if(c.status === 'OPEN') { %>
                                            <button onclick="withdrawComplaint('<%= c.fullId %>')" class="text-red-600 hover:text-red-900 bg-red-50 hover:bg-red-100 px-3 py-1 rounded-md transition text-xs font-bold shadow-sm">Withdraw</button>
                                        <% } else { %>
                                            <span class="text-gray-400 text-xs">Locked</span>
                                        <% } %>
                                    </td>
                                </tr>
                            <% }) %>
                        <% } %>
                    </tbody>
                </table>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Level 2: Client-side Form Validation & DOM Manipulation -->
<script>
    document.addEventListener('DOMContentLoaded', () => {
        // Form Validation
        const form = document.getElementById('complaintForm');
        const titleInput = document.getElementById('title');
        
        form.addEventListener('submit', async (e) => {
            e.preventDefault(); // Prevent full page reload for zero-lag UX
            let isValid = true;
            
            if(titleInput.value.trim().length < 5) {
                document.getElementById('titleError').classList.remove('hidden');
                titleInput.classList.add('border-red-500');
                isValid = false;
            } else {
                document.getElementById('titleError').classList.add('hidden');
                document.getElementById('title').classList.remove('border-red-500');
            }

            if(!isValid) return;

            const submitBtn = document.getElementById('submitBtn');
            const btnText = document.getElementById('btnText');
            const btnSpinner = document.getElementById('btnSpinner');

            const title = titleInput.value.trim();
            const buildingId = document.getElementById('buildingId').value;
            const room = document.getElementById('room').value.trim();
            const description = document.getElementById('description').value.trim();

            // Show loading state
            btnText.classList.add('hidden');
            btnSpinner.classList.remove('hidden');
            submitBtn.disabled = true;

            try {
                const response = await fetch('/api/complaints', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ title, buildingId, room, description })
                });

                if (response.ok) {
                    // Fast DOM update without reload
                    const newComplaint = await response.json();
                    addComplaintToTable(newComplaint);
                    form.reset();
                } else {
                    alert("Failed to submit. Please check your inputs.");
                }
            } catch (error) {
                alert("Network error occurred.");
            } finally {
                // Restore button state
                submitBtn.disabled = false;
                btnText.textContent = 'Submit Request';
                btnSpinner.classList.add('hidden');
            }
        });

        function addComplaintToTable(c) {
            const tbody = document.querySelector('#complaintsTable tbody');
            // Remove empty state if exists
            const emptyState = tbody.querySelector('td[colspan="4"]');
            if(emptyState) emptyState.parentElement.remove();

            const tr = document.createElement('tr');
            tr.className = 'complaint-row fade-in';
            tr.dataset.status = c.status;
            
            tr.id = `row-${c.id}`;
            
            const date = new Date(c.createdAt).toLocaleString();
            const displayId = c.id.substring(0, 8); // The API returned full ID as c.id, we truncate for display
            
            tr.innerHTML = `
                <td class="px-6 py-4 whitespace-nowrap">
                    <div class="text-sm font-medium text-gray-900">#${displayId} ${c.title}</div>
                    <div class="text-xs text-gray-500">${date}</div>
                </td>
                <td class="px-6 py-4 whitespace-nowrap">
                    <span class="px-2 inline-flex text-xs leading-5 font-semibold rounded-full bg-purple-100 text-purple-800">
                        ${c.category}
                    </span>
                </td>
                <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">
                    ${c.building} ${c.roomNumber ? '- ' + c.roomNumber : ''}
                </td>
                <td class="px-6 py-4 whitespace-nowrap">
                    <span class="px-2 inline-flex text-xs leading-5 font-semibold rounded-full bg-yellow-100 text-yellow-800">${c.status}</span>
                </td>
                <td class="px-6 py-4 whitespace-nowrap text-right text-sm font-medium">
                    <button onclick="withdrawComplaint('${c.id}')" class="text-red-600 hover:text-red-900 bg-red-50 hover:bg-red-100 px-3 py-1 rounded-md transition text-xs font-bold shadow-sm">Withdraw</button>
                </td>
            `;
            tbody.prepend(tr); // Add to top
        }
        
        // Expose withdrawal function globally
        window.withdrawComplaint = async function(id) {
            if(!confirm("Are you sure you want to withdraw this complaint?")) return;

            try {
                const response = await fetch(`/api/complaints/${id}`, {
                    method: 'DELETE'
                });

                if(response.ok) {
                    const row = document.getElementById(`row-${id}`);
                    if(row) {
                        row.style.transition = "opacity 0.3s ease";
                        row.style.opacity = "0";
                        setTimeout(() => row.remove(), 300);
                    }
                } else {
                    const err = await response.json();
                    alert(err.error || "Failed to withdraw");
                }
            } catch(e) {
                alert("Network error");
            }
        };

        // Dynamic DOM Manipulation (Filtering)
        const statusFilter = document.getElementById('statusFilter');
        const rows = document.querySelectorAll('.complaint-row');

        statusFilter.addEventListener('change', (e) => {
            const filterValue = e.target.value;
            rows.forEach(row => {
                if(filterValue === 'All' || row.dataset.status === filterValue) {
                    row.style.display = '';
                } else {
                    row.style.display = 'none';
                }
            });
        });
    });
</script>

<%- include('partials/footer') %>
