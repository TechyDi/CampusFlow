<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Staff Dashboard - CampusFlow</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <style>body { font-family: 'Inter', sans-serif; }</style>
</head>
<body class="bg-gray-50 min-h-screen">
    <%- include('partials/header') %>

    <main class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
        <div class="mb-8">
            <h1 class="text-3xl font-bold text-gray-900">My Assigned Tasks</h1>
            <p class="text-gray-500">View and update the status of your work orders.</p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
            <% if (tasks.length === 0) { %>
                <div class="col-span-full p-8 text-center text-gray-500 bg-white rounded-2xl shadow-md hover:shadow-lg transition-shadow duration-300 border border-gray-100">
                    You have no assigned tasks. Great job!
                </div>
            <% } else { %>
                <% tasks.forEach(t => { %>
                    <div class="bg-white rounded-2xl shadow-md hover:shadow-lg transition-shadow duration-300 border border-gray-100 p-6 flex flex-col justify-between">
                        <div>
                            <div class="flex justify-between items-start mb-3">
                                <span class="px-2.5 py-1 text-xs font-bold rounded uppercase tracking-wider
                                    <%= t.status === 'ASSIGNED' ? 'bg-yellow-100 text-yellow-800' : 
                                       t.status === 'IN_PROGRESS' ? 'bg-blue-100 text-blue-800' : 
                                       t.status === 'PENDING_VERIFICATION' ? 'bg-purple-100 text-purple-800' :
                                       'bg-green-100 text-green-800' %>">
                                    <%= t.status === 'PENDING_VERIFICATION' ? 'VERIFYING' : t.status %>
                                </span>
                                <span class="text-xs text-gray-400 font-medium"><%= new Date(t.createdAt).toLocaleDateString() %></span>
                            </div>
                            <h3 class="text-lg font-bold text-gray-900 mb-1"><%= t.title %></h3>
                            <p class="text-sm text-gray-500 mb-4 line-clamp-2"><%= t.description %></p>
                            
                            <div class="text-xs text-gray-500 space-y-1 mb-4">
                                <p><span class="font-bold">Building/Room:</span> <%= t.building.name %> (<%= t.roomNumber %>)</p>
                                <p><span class="font-bold">Category:</span> <%= t.category.name %></p>
                                <p><span class="font-bold">Student Contact:</span> <%= t.student.name %></p>
                            </div>
                        </div>
                        
                        <% if (t.status !== 'RESOLVED' && t.status !== 'PENDING_VERIFICATION') { %>
                            <div class="mt-4 pt-4 border-t border-gray-100 flex space-x-2">
                                <% if (t.status === 'ASSIGNED') { %>
                                    <button onclick="updateStatus('<%= t.id %>', 'IN_PROGRESS')" class="flex-1 bg-blue-50 text-blue-700 hover:bg-blue-100 font-bold py-2 px-3 rounded text-sm transition">
                                        Start Work
                                    </button>
                                <% } %>
                                <button onclick="updateStatus('<%= t.id %>', 'PENDING_VERIFICATION')" class="flex-1 bg-green-600 hover:bg-green-700 text-white font-bold py-2 px-3 rounded text-sm transition shadow-sm">
                                    Mark Resolved
                                </button>
                            </div>
                        <% } %>
                    </div>
                <% }) %>
            <% } %>
        </div>
    </main>

    <script>
        async function updateStatus(taskId, status) {
            if(!confirm(`Are you sure you want to mark this task as ${status.replace('_', ' ')}?`)) return;
            try {
                const res = await fetch(`/api/staff/complaints/${taskId}/status`, {
                    method: 'PUT',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ status })
                });
                if(res.ok) {
                    window.location.reload();
                } else {
                    alert('Status update failed');
                }
            } catch(e) {
                alert('Network error');
            }
        }
    </script>
</body>
</html>
