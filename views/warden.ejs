<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Warden Dashboard - CampusFlow</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <style>body { font-family: 'Inter', sans-serif; }</style>
</head>
<body class="bg-gray-50 min-h-screen">
    <%- include('partials/header') %>

    <main class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
        <div class="mb-8 flex justify-between items-end">
            <div>
                <h1 class="text-3xl font-bold text-gray-900">Warden Dashboard</h1>
                <p class="text-gray-500">Oversee all institution complaints and assign staff.</p>
            </div>
            <div class="flex space-x-4 items-center">
                <div class="flex space-x-2 bg-gray-200 p-1 rounded-lg">
                    <button onclick="switchTab('complaints')" id="tab-complaints" class="px-4 py-2 text-sm font-bold rounded-md bg-white shadow-sm text-gray-900">Complaints</button>
                    <button onclick="switchTab('staff')" id="tab-staff" class="px-4 py-2 text-sm font-bold rounded-md text-gray-600 hover:text-gray-900">Staff Availability</button>
                </div>
                <select id="statusFilter" onchange="filterComplaints()" class="bg-white border border-gray-300 text-gray-900 text-sm rounded-lg focus:ring-blue-500 focus:border-blue-500 block p-2.5 shadow-sm">
                    <option value="ALL">All Statuses</option>
                    <option value="OPEN">Open</option>
                    <option value="ASSIGNED">Assigned</option>
                    <option value="IN_PROGRESS">In Progress</option>
                    <option value="PENDING_VERIFICATION">Verifying</option>
                    <option value="RESOLVED">Resolved</option>
                </select>
            </div>
        </div>

        <div id="section-complaints">
            <!-- Invite Students -->
            <div class="bg-blue-50 rounded-2xl shadow-md hover:shadow-lg transition-shadow duration-300 border border-blue-100 p-6 mb-8 flex flex-col md:flex-row items-center justify-between">
                <div>
                    <h2 class="text-xl font-bold text-blue-900 mb-2">Invite Users</h2>
                    <p class="text-blue-700 mb-4">Share this link or QR code with students and staff so they can join your institution.</p>
                    <div class="flex items-center space-x-2">
                        <input type="text" id="invite-link-warden" readonly value="http://localhost:3000/signup?institutionId=<%= user.institutionId %>" class="px-4 py-2 bg-white border border-blue-200 rounded-md w-72 text-sm text-gray-600 font-mono">
                        <button onclick="navigator.clipboard.writeText(document.getElementById('invite-link-warden').value); alert('Copied!');" class="bg-blue-600 hover:bg-blue-700 text-white px-4 py-2 rounded-md text-sm font-bold transition">Copy</button>
                    </div>
                </div>
                <div class="mt-4 md:mt-0 bg-white p-2 rounded-lg shadow-sm border border-gray-100">
                    <img src="https://api.qrserver.com/v1/create-qr-code/?size=120x120&data=http://localhost:3000/signup?institutionId=<%= user.institutionId %>" alt="QR Code" class="w-24 h-24">
                </div>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6" id="complaintsGrid">
                <% complaints.forEach(c => { %>
                <div class="complaint-card bg-white rounded-2xl shadow-md hover:shadow-lg transition-shadow duration-300 border border-gray-100 p-6 flex flex-col justify-between" data-status="<%= c.status %>">
                    <div>
                        <div class="flex justify-between items-start mb-3">
                            <span class="px-2.5 py-1 text-xs font-bold rounded uppercase tracking-wider
                                <%= c.status === 'OPEN' ? 'bg-red-100 text-red-800' : 
                                   c.status === 'ASSIGNED' ? 'bg-yellow-100 text-yellow-800' : 
                                   c.status === 'IN_PROGRESS' ? 'bg-blue-100 text-blue-800' : 
                                   c.status === 'PENDING_VERIFICATION' ? 'bg-purple-100 text-purple-800' :
                                   'bg-green-100 text-green-800' %>">
                                <%= c.status === 'PENDING_VERIFICATION' ? 'VERIFYING' : c.status %>
                            </span>
                            <span class="text-xs text-gray-400 font-medium"><%= new Date(c.createdAt).toLocaleDateString() %></span>
                        </div>
                        <h3 class="text-lg font-bold text-gray-900 mb-1"><%= c.title %></h3>
                        <p class="text-sm text-gray-500 mb-4 line-clamp-2"><%= c.description %></p>
                        
                        <div class="text-xs text-gray-500 space-y-1 mb-4">
                            <p><span class="font-bold">Building:</span> <%= c.building.name %></p>
                            <p><span class="font-bold">Category:</span> <%= c.category.name %></p>
                            <% if (c.student.role === 'STAFF') { %>
                                <p class="animate-pulse text-red-600 font-bold mt-2">GROUND STAFF COMPLAINT</p>
                            <% } else { %>
                                <p><span class="font-bold">Primary Student:</span> <%= c.student.name %></p>
                            <% } %>
                            <% if (c.subComplaints && c.subComplaints.length > 0) { %>
                                <p class="text-orange-600 font-bold mt-2 flex items-center">
                                    <svg class="w-4 h-4 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"></path></svg>
                                    +<%= c.subComplaints.length %> other students reported this duplicate issue
                                </p>
                            <% } %>
                            <% if(c.assignedStaff) { %>
                                <p class="text-blue-600 font-semibold mt-2">Assigned to: <%= c.assignedStaff.name %></p>
                            <% } %>
                            <div class="mt-4 bg-gray-50 p-3 rounded-lg border border-gray-200">
                                <label class="block text-xs font-bold text-gray-700 mb-1">Warden Remark</label>
                                <textarea id="remark-<%= c.id %>" rows="2" class="w-full text-xs p-2 border border-gray-300 rounded mb-2 focus:ring-blue-500 focus:border-blue-500" placeholder="Add a remark..."><%= c.wardenRemark || '' %></textarea>
                                <button onclick="saveRemark('<%= c.id %>')" class="bg-gray-800 hover:bg-black text-white text-xs font-bold py-1 px-3 rounded transition shadow-sm w-full">Save Remark</button>
                            </div>
                        </div>
                    </div>
                    
                    <% if (c.status === 'OPEN') { %>
                        <div class="mt-4 pt-4 border-t border-gray-100">
                            <label class="block text-xs font-bold text-gray-700 mb-1">Assign Staff</label>
                            <div class="flex space-x-2">
                                <select id="staff-<%= c.id %>" class="flex-1 bg-gray-50 border border-gray-300 text-gray-900 text-xs rounded-lg focus:ring-blue-500 focus:border-blue-500 p-2">
                                    <option value="" disabled selected>Select worker</option>
                                    <% staffMembers.forEach(s => { %>
                                        <option value="<%= s.id %>"><%= s.name %></option>
                                    <% }) %>
                                </select>
                                <button onclick="assignStaff('<%= c.id %>')" class="bg-blue-600 hover:bg-blue-700 text-white text-xs font-bold py-2 px-3 rounded transition shadow-sm">
                                    Assign
                                </button>
                            </div>
                        </div>
                    <% } %>

                    <% if (c.status === 'PENDING_VERIFICATION') { %>
                        <div class="mt-4 pt-4 border-t border-gray-100">
                            <button onclick="updateStatus('<%= c.id %>', 'RESOLVED')" class="w-full bg-green-600 hover:bg-green-700 text-white font-bold py-2 px-3 rounded text-sm transition shadow-sm">
                                Verify & Mark as Resolved
                            </button>
                        </div>
                    <% } %>
                </div>
            <% }) %>
            </div>
        </div>

        <div id="section-staff" style="display: none;">
            <div class="bg-white rounded-2xl shadow-md hover:shadow-lg transition-shadow duration-300 border border-gray-100 overflow-hidden">
                <table class="min-w-full divide-y divide-gray-200">
                    <thead class="bg-gray-50">
                        <tr>
                            <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Staff Member</th>
                            <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Email</th>
                            <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Status</th>
                            <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Active Tickets</th>
                        </tr>
                    </thead>
                    <tbody class="bg-white divide-y divide-gray-200">
                        <% staffMembers.forEach(s => { %>
                            <tr>
                                <td class="px-6 py-4 whitespace-nowrap">
                                    <div class="text-sm font-medium text-gray-900"><%= s.name %></div>
                                </td>
                                <td class="px-6 py-4 whitespace-nowrap">
                                    <div class="text-sm text-gray-500"><%= s.email %></div>
                                </td>
                                <td class="px-6 py-4 whitespace-nowrap">
                                    <% if (s.assignedTasks && s.assignedTasks.length > 0) { %>
                                        <span class="px-2 inline-flex text-xs leading-5 font-semibold rounded-full bg-red-100 text-red-800">
                                            Busy
                                        </span>
                                    <% } else { %>
                                        <span class="px-2 inline-flex text-xs leading-5 font-semibold rounded-full bg-green-100 text-green-800">
                                            Free
                                        </span>
                                    <% } %>
                                </td>
                                <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">
                                    <%= s.assignedTasks ? s.assignedTasks.length : 0 %> active
                                </td>
                            </tr>
                        <% }) %>
                    </tbody>
                </table>
            </div>
        </div>
    </main>

    <script>
        function filterComplaints() {
            const filter = document.getElementById('statusFilter').value;
            const cards = document.querySelectorAll('.complaint-card');
            cards.forEach(card => {
                if (filter === 'ALL' || card.dataset.status === filter) {
                    card.style.display = 'flex';
                } else {
                    card.style.display = 'none';
                }
            });
        }

        function switchTab(tab) {
            document.getElementById('section-complaints').style.display = tab === 'complaints' ? 'block' : 'none';
            document.getElementById('section-staff').style.display = tab === 'staff' ? 'block' : 'none';
            
            const btnComplaints = document.getElementById('tab-complaints');
            const btnStaff = document.getElementById('tab-staff');

            if(tab === 'complaints') {
                btnComplaints.className = "px-4 py-2 text-sm font-bold rounded-md bg-white shadow-sm text-gray-900";
                btnStaff.className = "px-4 py-2 text-sm font-bold rounded-md text-gray-600 hover:text-gray-900";
                document.getElementById('statusFilter').style.display = 'block';
            } else {
                btnStaff.className = "px-4 py-2 text-sm font-bold rounded-md bg-white shadow-sm text-gray-900";
                btnComplaints.className = "px-4 py-2 text-sm font-bold rounded-md text-gray-600 hover:text-gray-900";
                document.getElementById('statusFilter').style.display = 'none';
            }
        }

        async function assignStaff(complaintId) {
            const staffId = document.getElementById(`staff-${complaintId}`).value;
            if(!staffId) return alert('Please select a staff member');

            try {
                const res = await fetch(`/api/warden/complaints/${complaintId}/assign`, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ staffId })
                });
                if(res.ok) {
                    window.location.reload();
                } else {
                    alert('Assignment failed');
                }
            } catch(e) {
                alert('Network error');
            }
        }

        async function saveRemark(complaintId) {
            const remark = document.getElementById(`remark-${complaintId}`).value;
            try {
                const res = await fetch(`/api/warden/complaints/${complaintId}/remark`, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ remark })
                });
                if(res.ok) {
                    alert('Remark saved successfully!');
                } else {
                    alert('Failed to save remark.');
                }
            } catch(e) {
                alert('Network error');
            }
        }

        async function updateStatus(taskId, status) {
            if(!confirm(`Are you sure you want to mark this task as ${status}?`)) return;
            const btn = document.querySelector(`button[onclick="updateStatus('${taskId}', '${status}')"]`);
            if(btn) { btn.disabled = true; btn.innerText = 'Verifying...'; }
            try {
                const res = await fetch(`/api/staff/complaints/${taskId}/status`, {
                    method: 'PUT',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ status })
                });
                if(res.ok) {
                    window.location.reload();
                } else {
                    alert('Status update failed');
                    if(btn) { btn.disabled = false; btn.innerText = 'Verify & Mark as Resolved'; }
                }
            } catch(e) { 
                alert('Network error'); 
                if(btn) { btn.disabled = false; btn.innerText = 'Verify & Mark as Resolved'; }
            }
        }
    </script>
</body>
</html>
