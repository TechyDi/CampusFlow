<%- include('partials/header') %>

<main class="max-w-7xl mx-auto px-6 py-8">
    <div class="mb-8 flex justify-between items-end border-b border-gray-200 pb-4">
        <div>
            <h1 class="text-3xl font-extrabold text-gray-900 tracking-tight">Campus Marketplace</h1>
            <p class="text-sm text-gray-500 mt-1">Buy and sell textbooks, electronics, and dorm essentials.</p>
        </div>
    </div>

    <!-- Tabs -->
    <div class="mb-6 flex space-x-4 border-b border-gray-200">
        <button onclick="switchTab('campus')" id="tab-campus" class="pb-2 border-b-2 font-bold text-lg text-blue-600 border-blue-600 transition">Campus Feed</button>
        <button onclick="switchTab('mine')" id="tab-mine" class="pb-2 border-b-2 font-bold text-lg text-gray-500 border-transparent hover:text-gray-700 transition">My Listings</button>
        <button onclick="switchTab('inbox')" id="tab-inbox" class="pb-2 border-b-2 font-bold text-lg text-gray-500 border-transparent hover:text-gray-700 transition relative">
            Inbox 
            <% if (locals.unreadMessageCount && locals.unreadMessageCount > 0) { %>
                <span class="absolute -top-1 -right-3 bg-red-500 text-white text-[10px] font-bold px-1.5 py-0.5 rounded-full"><%= unreadMessageCount %></span>
            <% } %>
        </button>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-4 gap-8">
        <!-- Sell Form Sidebar -->
        <div class="lg:col-span-1">
            <div class="bg-white rounded-xl shadow-md border border-gray-100 p-6 sticky top-6">
                <h2 class="text-lg font-bold text-gray-900 mb-4 border-b border-gray-100 pb-2">Sell an Item</h2>
                <form id="marketForm" class="space-y-4">
                    <div>
                        <label class="block text-sm font-medium text-gray-700 mb-1">Title</label>
                        <input type="text" id="title" required placeholder="e.g. Calculus Textbook" class="w-full border border-gray-300 rounded-md px-3 py-2 text-sm focus:ring-blue-500 focus:border-blue-500">
                    </div>
                    <div>
                        <label class="block text-sm font-medium text-gray-700 mb-1">Images (Up to 5)</label>
                        <input type="file" id="images" accept="image/*" multiple class="w-full border border-gray-300 rounded-md px-3 py-2 text-sm focus:ring-blue-500 focus:border-blue-500">
                    </div>
                    <div>
                        <label class="block text-sm font-medium text-gray-700 mb-1">Price ($)</label>
                        <input type="number" id="price" required min="0" step="0.01" placeholder="45.00" class="w-full border border-gray-300 rounded-md px-3 py-2 text-sm focus:ring-blue-500 focus:border-blue-500">
                    </div>
                    <div>
                        <label class="block text-sm font-medium text-gray-700 mb-1">Condition</label>
                        <select id="condition" required class="w-full border border-gray-300 rounded-md px-3 py-2 text-sm focus:ring-blue-500 focus:border-blue-500">
                            <option value="New">New</option>
                            <option value="Like New">Like New</option>
                            <option value="Good" selected>Good</option>
                            <option value="Used">Used</option>
                        </select>
                    </div>
                    <div>
                        <label class="block text-sm font-medium text-gray-700 mb-1">Description</label>
                        <textarea id="description" required rows="3" class="w-full border border-gray-300 rounded-md px-3 py-2 text-sm focus:ring-blue-500 focus:border-blue-500" placeholder="Details about the item..."></textarea>
                    </div>
                    <div>
                        <label class="block text-sm font-medium text-gray-700 mb-1">Contact Info</label>
                        <input type="text" id="contactInfo" required placeholder="Email or Phone number" class="w-full border border-gray-300 rounded-md px-3 py-2 text-sm focus:ring-blue-500 focus:border-blue-500">
                    </div>
                    
                    <button type="submit" id="submitBtn" class="w-full bg-green-600 text-white font-bold py-2.5 rounded-md hover:bg-green-700 transition flex justify-center items-center shadow-sm">
                        <span id="btnText">List Item</span>
                    </button>
                </form>
            </div>
        </div>

        <!-- Items Feed -->
        <div class="lg:col-span-3">
            
            <!-- CAMPUS FEED -->
            <div id="content-campus">
                <% 
                   const campusItems = items; 
                   if(campusItems.length === 0) { 
                %>
                    <div class="bg-gray-50 rounded-lg p-12 text-center border border-dashed border-gray-300">
                        <p class="text-gray-500 text-lg font-medium">No items from other students right now.</p>
                    </div>
                <% } else { %>
                    <div class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-3 gap-6">
                        <% campusItems.forEach(item => { 
                            let images = [];
                            try { images = JSON.parse(item.imageUrls || "[]"); } catch(e){}
                        %>
                            <div class="bg-white rounded-xl shadow-sm border border-gray-200 overflow-hidden fade-in flex flex-col relative">
                                <% if (item.status === 'SOLD') { %>
                                    <div class="absolute inset-0 bg-white/70 backdrop-blur-[2px] flex items-center justify-center z-20">
                                        <span class="bg-gray-800 text-white text-lg font-black tracking-widest px-6 py-2 rounded shadow-lg transform -rotate-12 border-2 border-gray-900">SOLD</span>
                                    </div>
                                <% } %>
                                
                                <div class="h-48 bg-gray-100 border-b border-gray-200 flex items-center justify-center relative overflow-hidden group">
                                    <% if (images.length > 0) { %>
                                        <div class="flex overflow-x-auto snap-x snap-mandatory w-full h-full pb-2">
                                            <% images.forEach((img, idx) => { %>
                                                <img src="<%= img %>" class="snap-center object-cover w-full h-full flex-shrink-0" alt="Item Image <%= idx+1 %>">
                                            <% }) %>
                                        </div>
                                        <% if (images.length > 1) { %>
                                            <div class="absolute bottom-2 right-2 bg-black/50 text-white text-[10px] px-2 py-1 rounded-full"><%= images.length %> Photos</div>
                                        <% } %>
                                    <% } else { %>
                                        <svg class="w-12 h-12 text-gray-300" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"></path></svg>
                                    <% } %>
                                    <div class="absolute top-3 right-3 bg-white/90 backdrop-blur-sm px-2 py-1 rounded text-xs font-bold text-gray-700 shadow-sm border border-gray-200 z-10">
                                        <%= item.condition %>
                                    </div>
                                </div>

                                <div class="p-5 flex-grow flex flex-col">
                                    <h3 class="font-bold text-gray-900 text-lg leading-tight line-clamp-2 mb-2"><%= item.title %></h3>
                                    <p class="text-2xl font-black text-green-600 mb-3">$<%= item.price.toFixed(2) %></p>
                                    <p class="text-sm text-gray-600 line-clamp-3 mb-4 flex-grow"><%= item.description %></p>
                                    <div class="pt-4 border-t border-gray-100">
                                        <p class="text-xs text-gray-500 mb-3 font-medium">Seller: <span class="text-gray-900"><%= item.seller.name %></span></p>
                                        <% if (item.studentId === currentUserId) { %>
                                            <div class="absolute top-0 left-0 bg-indigo-600 text-white text-xs font-bold px-3 py-1 rounded-br-lg z-30 shadow-md">Listed By You</div>
                                            <div class="w-full bg-gray-100 text-gray-600 font-bold py-2 rounded text-center shadow-sm text-sm">Your Listing</div>
                                        <% } else if (item.status === 'AVAILABLE') { %>
                                            <button onclick="buyItem('<%= item.id %>')" class="w-full bg-blue-600 hover:bg-blue-700 text-white font-bold py-2 rounded transition shadow-sm text-sm">Buy Now / Contact Seller</button>
                                        <% } %>
                                    </div>
                                </div>
                            </div>
                        <% }) %>
                    </div>
                <% } %>
            </div>

            <!-- MY LISTINGS -->
            <div id="content-mine" class="hidden">
                <% 
                   const myItems = items.filter(i => i.studentId === currentUserId); 
                   if(myItems.length === 0) { 
                %>
                    <div class="bg-gray-50 rounded-lg p-12 text-center border border-dashed border-gray-300">
                        <p class="text-gray-500 text-lg font-medium">You haven't listed any items yet.</p>
                    </div>
                <% } else { %>
                    <div class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-3 gap-6">
                        <% myItems.forEach(item => { 
                            let images = [];
                            try { images = JSON.parse(item.imageUrls || "[]"); } catch(e){}
                        %>
                            <div class="bg-indigo-50/30 rounded-xl shadow-sm border border-indigo-200 overflow-hidden fade-in flex flex-col relative">
                                <div class="absolute top-0 left-0 bg-indigo-600 text-white text-xs font-bold px-3 py-1 rounded-br-lg z-30 shadow-md">Listed By You</div>
                                
                                <% if (item.status === 'SOLD') { %>
                                    <div class="absolute inset-0 bg-white/70 backdrop-blur-[2px] flex items-center justify-center z-20">
                                        <span class="bg-gray-800 text-white text-lg font-black tracking-widest px-6 py-2 rounded shadow-lg transform -rotate-12 border-2 border-gray-900">SOLD</span>
                                    </div>
                                <% } %>
                                
                                <div class="h-48 bg-gray-100 border-b border-gray-200 flex items-center justify-center relative overflow-hidden">
                                    <% if (images.length > 0) { %>
                                        <div class="flex overflow-x-auto snap-x snap-mandatory w-full h-full pb-2">
                                            <% images.forEach((img, idx) => { %>
                                                <img src="<%= img %>" class="snap-center object-cover w-full h-full flex-shrink-0" alt="Item Image <%= idx+1 %>">
                                            <% }) %>
                                        </div>
                                    <% } else { %>
                                        <svg class="w-12 h-12 text-gray-300" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"></path></svg>
                                    <% } %>
                                </div>

                                <div class="p-5 flex-grow flex flex-col">
                                    <h3 class="font-bold text-gray-900 text-lg leading-tight line-clamp-2 mb-2"><%= item.title %></h3>
                                    <p class="text-2xl font-black text-indigo-600 mb-3">$<%= item.price.toFixed(2) %></p>
                                    <p class="text-sm text-gray-600 line-clamp-3 mb-4 flex-grow"><%= item.description %></p>
                                    <div class="pt-4 border-t border-indigo-100 flex space-x-2">
                                        <button onclick="openEditModal('<%= item.id %>', '<%= encodeURIComponent(item.title) %>', '<%= item.price %>', '<%= item.condition %>', '<%= encodeURIComponent(item.description) %>', '<%= encodeURIComponent(item.contactInfo) %>')" class="flex-1 bg-white border border-gray-300 hover:bg-gray-50 text-gray-700 font-bold py-2 rounded text-sm transition">Edit</button>
                                        <button onclick="deleteListing('<%= item.id %>')" class="flex-1 bg-white border border-red-300 hover:bg-red-50 text-red-600 font-bold py-2 rounded text-sm transition">Delete</button>
                                    </div>
                                    <% if (item.status === 'AVAILABLE') { %>
                                        <button onclick="markSold('<%= item.id %>')" class="mt-2 w-full py-2 bg-indigo-900 text-white text-sm font-bold hover:bg-indigo-800 transition rounded shadow-sm">Mark as Sold Offline</button>
                                    <% } %>
                                </div>
                            </div>
                        <% }) %>
                    </div>
                <% } %>
            </div>
            <!-- INBOX -->
            <div id="content-inbox" class="hidden">
                <h2 class="text-xl font-bold mb-4 text-gray-800">Messages & Inquiries</h2>
                <% if (!messages || messages.length === 0) { %>
                    <div class="bg-white rounded-xl shadow-sm border border-gray-200 p-8 text-center">
                        <p class="text-gray-500 font-medium">Your inbox is empty.</p>
                    </div>
                <% } else { %>
                    <div class="space-y-4">
                        <% messages.forEach(msg => { %>
                            <div class="bg-white rounded-xl shadow-sm border border-gray-200 p-4 hover:bg-gray-50 transition">
                                <div class="flex justify-between items-start mb-2">
                                    <div class="font-bold text-gray-900"><%= msg.sender.name %></div>
                                    <div class="text-xs text-gray-500"><%= new Date(msg.createdAt).toLocaleString() %></div>
                                </div>
                                <div class="text-gray-700 text-sm whitespace-pre-line bg-gray-50 p-3 rounded border border-gray-100"><%= msg.content %></div>
                                <div class="mt-3 text-xs text-gray-500">
                                    <strong>Contact them at:</strong> <%= msg.sender.email %>
                                </div>
                            </div>
                        <% }) %>
                    </div>
                <% } %>
            </div>
        </div>
    </div>
</main>

<!-- Edit Modal -->
<div id="editModal" class="fixed inset-0 bg-gray-900/50 hidden items-center justify-center z-50">
    <div class="bg-white rounded-xl shadow-xl w-full max-w-md p-6">
        <h2 class="text-xl font-bold mb-4">Edit Listing</h2>
        <form id="editForm" class="space-y-4">
            <input type="hidden" id="editId">
            <div><label class="block text-sm font-medium mb-1">Title</label><input type="text" id="editTitle" required class="w-full border rounded px-3 py-2 text-sm"></div>
            <div><label class="block text-sm font-medium mb-1">Price</label><input type="number" id="editPrice" step="0.01" required class="w-full border rounded px-3 py-2 text-sm"></div>
            <div>
                <label class="block text-sm font-medium mb-1">Condition</label>
                <select id="editCondition" class="w-full border rounded px-3 py-2 text-sm">
                    <option value="New">New</option><option value="Like New">Like New</option><option value="Good">Good</option><option value="Used">Used</option>
                </select>
            </div>
            <div><label class="block text-sm font-medium mb-1">Description</label><textarea id="editDescription" required class="w-full border rounded px-3 py-2 text-sm"></textarea></div>
            <div><label class="block text-sm font-medium mb-1">Contact Info</label><input type="text" id="editContact" required class="w-full border rounded px-3 py-2 text-sm"></div>
            <div>
                <label class="block text-sm font-medium text-gray-700 mb-1">Add Images (Replaces existing)</label>
                <input type="file" id="editImages" accept="image/*" multiple class="w-full border border-gray-300 rounded-md px-3 py-2 text-sm">
            </div>
            <div class="flex space-x-3 pt-4">
                <button type="button" onclick="closeEditModal()" class="flex-1 border text-gray-700 py-2 rounded font-bold">Cancel</button>
                <button type="submit" class="flex-1 bg-blue-600 text-white py-2 rounded font-bold">Save Changes</button>
            </div>
        </form>
    </div>
</div>

<script>
    async function switchTab(tab) {
        // Reset Tabs
        const tabs = ['campus', 'mine', 'inbox'];
        tabs.forEach(t => {
            const btn = document.getElementById('tab-' + t);
            const content = document.getElementById('content-' + t);
            
            if (t === tab) {
                btn.classList.add('text-blue-600', 'border-blue-600');
                btn.classList.remove('text-gray-500', 'border-transparent');
                content.classList.remove('hidden');
            } else {
                btn.classList.remove('text-blue-600', 'border-blue-600');
                btn.classList.add('text-gray-500', 'border-transparent');
                content.classList.add('hidden');
            }
        });

        if (tab === 'inbox') {
            // Mark messages as read
            try {
                const response = await fetch('/api/market/messages/read', { method: 'POST' });
                if (response.ok) {
                    const navBadge = document.getElementById('nav-notification-badge');
                    if (navBadge) navBadge.style.display = 'none';
                    const tabBadge = document.querySelector('#tab-inbox span');
                    if (tabBadge) tabBadge.style.display = 'none';
                }
            } catch (e) {
                console.error('Failed to mark messages as read', e);
            }
        }
    }

    // Sell Form
    document.getElementById('marketForm').addEventListener('submit', async (e) => {
        e.preventDefault();
        const formData = new FormData();
        formData.append('title', document.getElementById('title').value);
        formData.append('price', document.getElementById('price').value);
        formData.append('condition', document.getElementById('condition').value);
        formData.append('description', document.getElementById('description').value);
        formData.append('contactInfo', document.getElementById('contactInfo').value);
        
        const files = document.getElementById('images').files;
        for(let i=0; i<files.length; i++) formData.append('images', files[i]);

        const response = await fetch('/api/marketplace', { method: 'POST', body: formData });
        if (response.ok) window.location.reload(); else alert("Failed to list item");
    });

    // Buy / Sold
    window.buyItem = async function(id) {
        const msg = prompt("Send a message to the seller to arrange pickup or negotiate:");
        if(msg === null) return; // User cancelled
        
        try {
            const response = await fetch(`/api/marketplace/${id}/message`, { 
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ message: msg })
            });
            const data = await response.json();
            if(response.ok) { 
                alert("Message sent! The seller will contact you."); 
            } else { 
                alert(data.error); 
            }
        } catch(e) {
            alert("Network error.");
        }
    };

    window.markSold = async function(id) {
        if(!confirm("Mark as sold?")) return;
        const response = await fetch(`/api/marketplace/${id}/sold`, { method: 'PUT' });
        if(response.ok) window.location.reload(); else alert("Error");
    };

    // Edit Logic
    function openEditModal(id, title, price, condition, desc, contact) {
        document.getElementById('editId').value = id;
        document.getElementById('editTitle').value = decodeURIComponent(title);
        document.getElementById('editPrice').value = price;
        document.getElementById('editCondition').value = condition;
        document.getElementById('editDescription').value = decodeURIComponent(desc);
        document.getElementById('editContact').value = decodeURIComponent(contact);
        document.getElementById('editModal').classList.remove('hidden');
        document.getElementById('editModal').classList.add('flex');
    }

    function closeEditModal() {
        document.getElementById('editModal').classList.add('hidden');
        document.getElementById('editModal').classList.remove('flex');
    }

    document.getElementById('editForm').addEventListener('submit', async (e) => {
        e.preventDefault();
        const id = document.getElementById('editId').value;
        const formData = new FormData();
        formData.append('title', document.getElementById('editTitle').value);
        formData.append('price', document.getElementById('editPrice').value);
        formData.append('condition', document.getElementById('editCondition').value);
        formData.append('description', document.getElementById('editDescription').value);
        formData.append('contactInfo', document.getElementById('editContact').value);
        
        const files = document.getElementById('editImages').files;
        for(let i=0; i<files.length; i++) formData.append('images', files[i]);

        const response = await fetch(`/api/marketplace/${id}`, { method: 'PUT', body: formData });
        if(response.ok) window.location.reload(); else alert("Failed to update");
    });

    window.deleteListing = async function(id) {
        if(!confirm("Permanently delete this listing?")) return;
        const response = await fetch(`/api/marketplace/${id}`, { method: 'DELETE' });
        if(response.ok) window.location.reload(); else alert("Failed to delete");
    };

</script>

<%- include('partials/footer') %>
