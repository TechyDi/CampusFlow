<%- include('partials/header') %>

<main class="max-w-7xl mx-auto px-6 py-8 fade-in">
    <div class="mb-8 border-b border-gray-200 pb-4 flex justify-between items-end">
        <div>
            <h1 class="text-3xl font-extrabold text-gray-900 tracking-tight">Platform Overview</h1>
            <p class="text-sm text-gray-500 mt-1">Super Admin Dashboard</p>
        </div>
        <a href="/superadmin/new" class="bg-blue-600 hover:bg-blue-700 text-white font-bold py-2 px-4 rounded shadow-sm transition">
            + New Institution
        </a>
    </div>

    <!-- Platform Stats -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-8">
        <div class="bg-white rounded-xl shadow-sm border border-gray-200 p-6 flex flex-col justify-center items-center">
            <h3 class="text-gray-500 font-bold text-sm uppercase tracking-wider mb-1">Total Institutions</h3>
            <p class="text-4xl font-black text-gray-800"><%= institutions.length %></p>
        </div>
        <div class="bg-white rounded-xl shadow-sm border border-gray-200 p-6 flex flex-col justify-center items-center">
            <h3 class="text-gray-500 font-bold text-sm uppercase tracking-wider mb-1">Total Users</h3>
            <p class="text-4xl font-black text-blue-600"><%= stats.totalUsers %></p>
        </div>
        <div class="bg-white rounded-xl shadow-sm border border-gray-200 p-6 flex flex-col justify-center items-center">
            <h3 class="text-gray-500 font-bold text-sm uppercase tracking-wider mb-1">Total Complaints</h3>
            <p class="text-4xl font-black text-red-500"><%= stats.totalComplaints %></p>
        </div>
    </div>

    <!-- Institutions List -->
    <div class="bg-white rounded-xl shadow-sm border border-gray-200 overflow-hidden">
        <div class="p-6 border-b border-gray-100 bg-gray-50">
            <h2 class="text-lg font-bold text-gray-800">Managed Institutions</h2>
        </div>
        <% if (institutions.length === 0) { %>
            <div class="p-8 text-center text-gray-500 font-medium">No institutions have been created yet.</div>
        <% } else { %>
            <div class="overflow-x-auto">
                <table class="w-full text-left border-collapse">
                    <thead>
                        <tr class="bg-gray-50 text-gray-500 text-xs uppercase tracking-wider border-b border-gray-200">
                            <th class="p-4 font-bold">Institution Name</th>
                            <th class="p-4 font-bold">Subdomain</th>
                            <th class="p-4 font-bold">Plan</th>
                            <th class="p-4 font-bold">Users</th>
                            <th class="p-4 font-bold">Buildings</th>
                            <th class="p-4 font-bold text-right">Actions</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-gray-100">
                        <% institutions.forEach(inst => { %>
                            <tr class="hover:bg-gray-50 transition">
                                <td class="p-4 font-bold text-gray-900"><%= inst.name %></td>
                                <td class="p-4"><span class="bg-blue-100 text-blue-800 px-2 py-1 rounded text-xs font-mono"><%= inst.subdomain %></span></td>
                                <td class="p-4">
                                    <select onchange="updatePlan('<%= inst.id %>', this.value)" class="bg-gray-50 border border-gray-300 text-gray-900 text-sm rounded focus:ring-blue-500 focus:border-blue-500 block w-full p-1 font-bold">
                                        <option value="FREE" <%= inst.subscriptionPlan === 'FREE' ? 'selected' : '' %>>FREE</option>
                                        <option value="PRO" <%= inst.subscriptionPlan === 'PRO' ? 'selected' : '' %>>PRO</option>
                                        <option value="ENTERPRISE" <%= inst.subscriptionPlan === 'ENTERPRISE' ? 'selected' : '' %>>ENTERPRISE</option>
                                    </select>
                                </td>
                                <td class="p-4 text-gray-600 font-medium"><%= inst._count.users %></td>
                                <td class="p-4 text-gray-600 font-medium"><%= inst._count.buildings %></td>
                                <td class="p-4 text-right">
                                    <button onclick="deleteInstitution('<%= inst.id %>')" class="text-red-500 hover:text-red-700 font-bold text-sm bg-red-50 hover:bg-red-100 px-3 py-1.5 rounded transition">Delete</button>
                                </td>
                            </tr>
                        <% }) %>
                    </tbody>
                </table>
            </div>
        <% } %>
    </div>
</main>

<script>
    async function deleteInstitution(id) {
        if(confirm("Are you sure you want to delete this institution? This action is permanent and will delete all associated users and data.")) {
            try {
                const res = await fetch(`/api/superadmin/institutions/${id}`, { method: 'DELETE' });
                if(res.ok) window.location.reload();
                else alert('Failed to delete institution');
            } catch(e) {
                alert('Network error');
            }
        }
    }

    async function updatePlan(id, plan) {
        try {
            const res = await fetch(`/api/superadmin/institutions/${id}/plan`, {
                method: 'PUT',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ subscriptionPlan: plan })
            });
            if(res.ok) {
                alert('Plan updated successfully');
                window.location.reload();
            } else {
                alert('Failed to update plan');
            }
        } catch(e) {
            alert('Network error');
        }
    }
</script>
</body>
</html>
