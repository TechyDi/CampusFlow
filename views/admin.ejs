<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Admin Dashboard - CampusFlow</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <style>body { font-family: 'Inter', sans-serif; }</style>
</head>
<body class="bg-gray-50 min-h-screen">
    <%- include('partials/header') %>

    <main class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
        <div class="mb-8">
            <h1 class="text-3xl font-bold text-gray-900">Institution Administration</h1>
            <p class="text-gray-500">Manage pending students and platform analytics.</p>
        </div>

        <!-- Analytics Cards -->
        <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-8">
            <div class="bg-white rounded-2xl shadow-md hover:shadow-lg transition-shadow duration-300 border border-gray-100 p-6">
                <h3 class="text-gray-500 text-sm font-semibold uppercase tracking-wider mb-2">Total Complaints</h3>
                <div class="text-3xl font-black text-gray-900"><%= totalComplaints %></div>
            </div>
            <div class="bg-white rounded-2xl shadow-md hover:shadow-lg transition-shadow duration-300 border border-gray-100 p-6">
                <h3 class="text-gray-500 text-sm font-semibold uppercase tracking-wider mb-2">Open Issues</h3>
                <div class="text-3xl font-black text-red-600"><%= openComplaints %></div>
            </div>
            <div class="bg-white rounded-2xl shadow-md hover:shadow-lg transition-shadow duration-300 border border-gray-100 p-6">
                <h3 class="text-gray-500 text-sm font-semibold uppercase tracking-wider mb-2">Resolution Rate</h3>
                <div class="text-3xl font-black text-green-600"><%= resolutionRate %>%</div>
            </div>
        </div>

        <!-- Invite Students -->
        <div class="bg-blue-50 rounded-2xl shadow-md hover:shadow-lg transition-shadow duration-300 border border-blue-100 p-6 mb-8 flex flex-col md:flex-row items-center justify-between">
            <div>
                <h2 class="text-xl font-bold text-blue-900 mb-2">Invite Users</h2>
                <p class="text-blue-700 mb-4">Share this link or QR code with students and staff so they can join your institution.</p>
                <div class="flex items-center space-x-2">
                    <input type="text" id="invite-link" readonly value="http://localhost:3000/signup?institutionId=<%= user.institutionId %>" class="px-4 py-2 bg-white border border-blue-200 rounded-md w-72 text-sm text-gray-600 font-mono">
                    <button onclick="navigator.clipboard.writeText(document.getElementById('invite-link').value); alert('Copied!');" class="bg-blue-600 hover:bg-blue-700 text-white px-4 py-2 rounded-md text-sm font-bold transition">Copy</button>
                </div>
            </div>
            <div class="mt-4 md:mt-0 bg-white p-2 rounded-lg shadow-sm border border-gray-100">
                <img src="https://api.qrserver.com/v1/create-qr-code/?size=120x120&data=http://localhost:3000/signup?institutionId=<%= user.institutionId %>" alt="QR Code" class="w-24 h-24">
            </div>
        </div>

        <!-- Tabs Navigation -->
        <div class="mb-6 border-b border-gray-200">
            <nav class="-mb-px flex space-x-8" aria-label="Tabs">
                <button onclick="switchTab('pending')" id="tab-pending" class="border-blue-500 text-blue-600 whitespace-nowrap py-4 px-1 border-b-2 font-medium text-sm transition-colors">
                    Pending Approvals (<%= pendingUsers.length %>)
                </button>
                <button onclick="switchTab('staff')" id="tab-staff" class="border-transparent text-gray-500 hover:text-gray-700 hover:border-gray-300 whitespace-nowrap py-4 px-1 border-b-2 font-medium text-sm transition-colors">
                    Staff Directory
                </button>
                <button onclick="switchTab('students')" id="tab-students" class="border-transparent text-gray-500 hover:text-gray-700 hover:border-gray-300 whitespace-nowrap py-4 px-1 border-b-2 font-medium text-sm transition-colors">
                    Student Directory
                </button>
                <button onclick="switchTab('buildings')" id="tab-buildings" class="border-transparent text-gray-500 hover:text-gray-700 hover:border-gray-300 whitespace-nowrap py-4 px-1 border-b-2 font-medium text-sm transition-colors">
                    Buildings
                </button>
                <button onclick="switchTab('complaints')" id="tab-complaints" class="border-transparent text-gray-500 hover:text-gray-700 hover:border-gray-300 whitespace-nowrap py-4 px-1 border-b-2 font-medium text-sm transition-colors">
                    Escalated Complaints
                </button>
                <button onclick="switchTab('all-complaints')" id="tab-all-complaints" class="border-transparent text-gray-500 hover:text-gray-700 hover:border-gray-300 whitespace-nowrap py-4 px-1 border-b-2 font-medium text-sm transition-colors">
                    All Complaints (Warden View)
                </button>
                <button onclick="switchTab('announcements')" id="tab-announcements" class="border-transparent text-gray-500 hover:text-gray-700 hover:border-gray-300 whitespace-nowrap py-4 px-1 border-b-2 font-medium text-sm transition-colors">
                    Campus Announcements
                </button>
                <button onclick="switchTab('queues')" id="tab-queues" class="border-transparent text-gray-500 hover:text-gray-700 hover:border-gray-300 whitespace-nowrap py-4 px-1 border-b-2 font-medium text-sm transition-colors">
                    Virtual Queues
                </button>
            </nav>
        </div>

        <!-- Pending Approvals Tab -->
        <div id="section-pending" class="tab-section block bg-white rounded-2xl shadow-md hover:shadow-lg transition-shadow duration-300 border border-gray-100 overflow-hidden">
            <div class="px-6 py-4 border-b border-gray-100 bg-gray-50/50">
                <h2 class="text-lg font-bold text-gray-900">Pending Student Approvals (<%= pendingUsers.length %>)</h2>
            </div>
            
            <% if (pendingUsers.length === 0) { %>
                <div class="p-8 text-center text-gray-500">No pending approvals.</div>
            <% } else { %>
                <ul class="divide-y divide-gray-100">
                    <% pendingUsers.forEach(u => { %>
                        <li class="p-6 flex items-center justify-between hover:bg-gray-50 transition">
                            <div>
                                <h3 class="font-bold text-gray-900"><%= u.name %></h3>
                                <p class="text-sm text-gray-500"><%= u.email %></p>
                                <p class="text-xs font-semibold text-blue-600 mt-1 uppercase tracking-wider">Role: <%= u.role %></p>
                            </div>
                            <div class="flex space-x-3">
                                <button onclick="handleApproval('<%= u.id %>', 'APPROVE')" class="px-4 py-2 bg-green-100 text-green-700 hover:bg-green-200 font-bold rounded shadow-sm text-sm transition">Approve</button>
                                <button onclick="handleApproval('<%= u.id %>', 'REJECT')" class="px-4 py-2 bg-red-100 text-red-700 hover:bg-red-200 font-bold rounded shadow-sm text-sm transition">Reject</button>
                            </div>
                        </li>
                    <% }) %>
                </ul>
            <% } %>
        </div>

        <!-- Staff Tab -->
        <div id="section-staff" class="tab-section hidden bg-white rounded-2xl shadow-md hover:shadow-lg transition-shadow duration-300 border border-gray-100 overflow-hidden">
            <div class="px-6 py-4 border-b border-gray-100 bg-gray-50/50 flex justify-between items-center">
                <h2 class="text-lg font-bold text-gray-900">Staff Directory</h2>
                <button onclick="openModal('staff-modal')" class="bg-blue-600 hover:bg-blue-700 text-white px-4 py-2 rounded-md text-sm font-bold transition">+ Add Staff</button>
            </div>
            <div class="overflow-x-auto">
                <table class="w-full text-left border-collapse">
                    <thead>
                        <tr class="bg-gray-50 border-b border-gray-100 text-xs uppercase tracking-wider text-gray-500">
                            <th class="p-4 font-semibold">Name</th>
                            <th class="p-4 font-semibold">Email</th>
                            <th class="p-4 font-semibold">Role</th>
                            <th class="p-4 font-semibold text-right">Actions</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-gray-100">
                        <% staffUsers.forEach(u => { %>
                            <tr class="hover:bg-gray-50">
                                <td class="p-4 font-medium text-gray-900"><%= u.name %></td>
                                <td class="p-4 text-gray-500"><%= u.email %></td>
                                <td class="p-4"><span class="px-2 py-1 bg-blue-50 text-blue-700 rounded text-xs font-bold"><%= u.role %></span></td>
                                <td class="p-4 text-right">
                                    <button onclick="deleteUser('<%= u.id %>')" class="text-red-500 hover:text-red-700 font-bold text-sm">Delete</button>
                                </td>
                            </tr>
                        <% }) %>
                    </tbody>
                </table>
            </div>
        </div>

        <!-- Students Tab -->
        <div id="section-students" class="tab-section hidden bg-white rounded-2xl shadow-md hover:shadow-lg transition-shadow duration-300 border border-gray-100 overflow-hidden">
            <div class="px-6 py-4 border-b border-gray-100 bg-gray-50/50 flex justify-between items-center">
                <h2 class="text-lg font-bold text-gray-900">Student Directory</h2>
                <button onclick="openModal('student-modal')" class="bg-blue-600 hover:bg-blue-700 text-white px-4 py-2 rounded-md text-sm font-bold transition">+ Add Student</button>
            </div>
            <div class="overflow-x-auto">
                <table class="w-full text-left border-collapse">
                    <thead>
                        <tr class="bg-gray-50 border-b border-gray-100 text-xs uppercase tracking-wider text-gray-500">
                            <th class="p-4 font-semibold">Name</th>
                            <th class="p-4 font-semibold">Email</th>
                            <th class="p-4 font-semibold text-right">Actions</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-gray-100">
                        <% studentUsers.forEach(u => { %>
                            <tr class="hover:bg-gray-50">
                                <td class="p-4 font-medium text-gray-900"><%= u.name %></td>
                                <td class="p-4 text-gray-500"><%= u.email %></td>
                                <td class="p-4 text-right">
                                    <button onclick="deleteUser('<%= u.id %>')" class="text-red-500 hover:text-red-700 font-bold text-sm">Delete</button>
                                </td>
                            </tr>
                        <% }) %>
                    </tbody>
                </table>
            </div>
        </div>

        <!-- Buildings Tab -->
        <div id="section-buildings" class="tab-section hidden bg-white rounded-2xl shadow-md hover:shadow-lg transition-shadow duration-300 border border-gray-100 overflow-hidden">
            <div class="px-6 py-4 border-b border-gray-100 bg-gray-50/50 flex justify-between items-center">
                <h2 class="text-lg font-bold text-gray-900">Buildings / Campuses</h2>
                <button onclick="openModal('building-modal')" class="bg-blue-600 hover:bg-blue-700 text-white px-4 py-2 rounded-md text-sm font-bold transition">+ Add Building</button>
            </div>
            <div class="overflow-x-auto">
                <table class="w-full text-left border-collapse">
                    <thead>
                        <tr class="bg-gray-50 border-b border-gray-100 text-xs uppercase tracking-wider text-gray-500">
                            <th class="p-4 font-semibold">Name</th>
                            <th class="p-4 font-semibold">Type</th>
                            <th class="p-4 font-semibold text-right">Actions</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-gray-100">
                        <% buildings.forEach(b => { %>
                            <tr class="hover:bg-gray-50">
                                <td class="p-4 font-medium text-gray-900"><%= b.name %></td>
                                <td class="p-4 text-gray-500"><%= b.type %></td>
                                <td class="p-4 text-right">
                                    <button onclick="deleteBuilding('<%= b.id %>')" class="text-red-500 hover:text-red-700 font-bold text-sm">Delete</button>
                                </td>
                            </tr>
                        <% }) %>
                    </tbody>
                </table>
            </div>
        </div>

        <!-- Complaints Tab -->
        <div id="section-complaints" class="tab-section hidden bg-white rounded-2xl shadow-md hover:shadow-lg transition-shadow duration-300 border border-gray-100 overflow-hidden">
            <div class="px-6 py-4 border-b border-gray-100 bg-gray-50/50 flex justify-between items-center">
                <h2 class="text-lg font-bold text-gray-900">Escalated Complaints</h2>
            </div>
            <div class="overflow-x-auto">
                <table class="w-full text-left border-collapse">
                    <thead>
                        <tr class="bg-gray-50 border-b border-gray-100 text-xs uppercase tracking-wider text-gray-500">
                            <th class="p-4 font-semibold">Title</th>
                            <th class="p-4 font-semibold">Reported By</th>
                            <th class="p-4 font-semibold">Location</th>
                            <th class="p-4 font-semibold">Status</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-gray-100">
                        <% if (adminComplaints.length === 0) { %>
                            <tr><td colspan="4" class="p-4 text-center text-gray-500">No escalated complaints found.</td></tr>
                        <% } else { %>
                            <% adminComplaints.forEach(c => { %>
                                <tr class="hover:bg-gray-50">
                                    <td class="p-4 font-medium text-gray-900"><%= c.title %></td>
                                    <td class="p-4 text-gray-500"><%= c.student.name %> (<%= c.student.role %>)</td>
                                    <td class="p-4 text-gray-500"><%= c.building.name %> <%= c.roomNumber ? '- ' + c.roomNumber : '' %></td>
                                    <td class="p-4 align-top">
                                        <select onchange="updateComplaintStatus('<%= c.id %>', this.value)" class="bg-gray-50 border border-gray-300 text-gray-900 text-sm rounded focus:ring-blue-500 focus:border-blue-500 block w-full p-1 font-bold mb-2">
                                            <option value="OPEN" <%= c.status === 'OPEN' ? 'selected' : '' %>>OPEN</option>
                                            <option value="ASSIGNED" <%= c.status === 'ASSIGNED' ? 'selected' : '' %>>ASSIGNED</option>
                                            <option value="IN_PROGRESS" <%= c.status === 'IN_PROGRESS' ? 'selected' : '' %>>IN_PROGRESS</option>
                                            <option value="PENDING_VERIFICATION" <%= c.status === 'PENDING_VERIFICATION' ? 'selected' : '' %>>VERIFYING</option>
                                            <option value="RESOLVED" <%= c.status === 'RESOLVED' ? 'selected' : '' %>>RESOLVED</option>
                                            <option value="CLOSED" <%= c.status === 'CLOSED' ? 'selected' : '' %>>CLOSED</option>
                                        </select>
                                        <div class="mt-2 text-xs">
                                            <textarea id="remark-<%= c.id %>" rows="2" class="w-full text-xs p-1 border border-gray-300 rounded mb-1 focus:ring-blue-500 focus:border-blue-500" placeholder="Add remark..."><%= c.wardenRemark || '' %></textarea>
                                            <button onclick="saveRemark('<%= c.id %>')" class="bg-gray-800 hover:bg-black text-white text-xs font-bold py-1 px-2 rounded w-full">Save Remark</button>
                                        </div>
                                    </td>
                                </tr>
                            <% }) %>
                        <% } %>
                    </tbody>
                </table>
            </div>
        </div>

        <!-- Warden View (All Complaints) Tab -->
        <div id="section-all-complaints" class="tab-section hidden bg-white rounded-2xl shadow-md hover:shadow-lg transition-shadow duration-300 border border-gray-100 overflow-hidden">
            <div class="px-6 py-4 border-b border-gray-100 bg-gray-50/50 flex justify-between items-center">
                <h2 class="text-lg font-bold text-gray-900">All Complaints (Warden View)</h2>
            </div>
            <div class="overflow-x-auto">
                <table class="w-full text-left border-collapse">
                    <thead>
                        <tr class="bg-gray-50 border-b border-gray-100 text-xs uppercase tracking-wider text-gray-500">
                            <th class="p-4 font-semibold">Title & ID</th>
                            <th class="p-4 font-semibold">Reported By</th>
                            <th class="p-4 font-semibold">Location</th>
                            <th class="p-4 font-semibold">Assignment</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-gray-100">
                        <% if (wardenComplaints.length === 0) { %>
                            <tr><td colspan="4" class="p-4 text-center text-gray-500">No complaints found.</td></tr>
                        <% } else { %>
                            <% wardenComplaints.forEach(c => { %>
                                <tr class="hover:bg-gray-50">
                                    <td class="p-4">
                                        <div class="font-medium text-gray-900"><%= c.title %></div>
                                        <div class="text-xs text-gray-400 font-mono"><%= c.id.substring(0,8) %></div>
                                    </td>
                                    <td class="p-4 text-gray-500"><%= c.student.name %> (<%= c.student.role %>)</td>
                                    <td class="p-4 text-gray-500"><%= c.building.name %> <%= c.roomNumber ? '- ' + c.roomNumber : '' %></td>
                                    <td class="p-4 align-top">
                                            <select id="staff-<%= c.id %>" onchange="assignStaff('<%= c.id %>', this.value)" class="w-full bg-gray-50 border border-gray-300 text-gray-900 text-xs rounded p-1 mb-1">
                                                <option value="" disabled selected>Select worker</option>
                                                <% staffUsers.filter(u => u.role === 'STAFF').forEach(s => { %>
                                                    <option value="<%= s.id %>" <%= c.assignedStaffId === s.id ? 'selected' : '' %>><%= s.name %> <%= s.assignedTasks && s.assignedTasks.length > 0 ? `(Busy - ${s.assignedTasks.length})` : '(Free)' %></option>
                                                <% }) %>
                                            </select>
                                            <% if (c.status === 'PENDING_VERIFICATION') { %>
                                                <button onclick="updateComplaintStatus('<%= c.id %>', 'RESOLVED')" class="mt-2 w-full bg-green-600 hover:bg-green-700 text-white font-bold py-1 px-2 rounded text-xs transition shadow-sm">
                                                    Verify & Resolve
                                                </button>
                                            <% } else if (c.status === 'OPEN') { %>
                                                <span class="text-xs font-bold text-red-500 uppercase">Open</span>
                                            <% } else if (c.status === 'RESOLVED' || c.status === 'CLOSED') { %>
                                                <span class="text-xs font-bold text-green-500 uppercase"><%= c.status %></span>
                                            <% } else { %>
                                                <span class="text-xs font-bold text-blue-500 uppercase"><%= c.status %></span>
                                            <% } %>
                                    </td>
                                </tr>
                            <% }) %>
                        <% } %>
                    </tbody>
                </table>
            </div>
        </div>

        <!-- Announcements Tab -->
        <div id="section-announcements" class="tab-section hidden bg-white rounded-2xl shadow-md hover:shadow-lg transition-shadow duration-300 border border-gray-100 overflow-hidden">
            <div class="px-6 py-4 border-b border-gray-100 bg-gray-50/50 flex justify-between items-center">
                <h2 class="text-lg font-bold text-gray-900">Campus Announcements</h2>
                <button onclick="openModal('announcement-modal')" class="bg-blue-600 hover:bg-blue-700 text-white px-4 py-2 rounded-md text-sm font-bold transition">+ Add Announcement</button>
            </div>
            <div class="overflow-x-auto">
                <table class="w-full text-left border-collapse">
                    <thead>
                        <tr class="bg-gray-50 border-b border-gray-100 text-xs uppercase tracking-wider text-gray-500">
                            <th class="p-4 font-semibold">Title</th>
                            <th class="p-4 font-semibold">Type</th>
                            <th class="p-4 font-semibold">Date Posted</th>
                            <th class="p-4 font-semibold text-right">Actions</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-gray-100">
                        <% if (announcements.length === 0) { %>
                            <tr><td colspan="4" class="p-4 text-center text-gray-500">No announcements found.</td></tr>
                        <% } else { %>
                            <% announcements.forEach(a => { %>
                                <tr class="hover:bg-gray-50">
                                    <td class="p-4 font-medium text-gray-900"><%= a.title %></td>
                                    <td class="p-4"><span class="px-2 py-1 bg-gray-100 text-gray-700 rounded text-xs font-bold"><%= a.type %></span></td>
                                    <td class="p-4 text-gray-500"><%= new Date(a.datePosted).toLocaleDateString() %></td>
                                    <td class="p-4 text-right">
                                        <button onclick="deleteAnnouncement('<%= a.id %>')" class="text-red-500 hover:text-red-700 font-bold text-sm">Delete</button>
                                    </td>
                                </tr>
                            <% }) %>
                        <% } %>
                    </tbody>
                </table>
            </div>
        </div>

        <!-- Queues Tab -->
        <div id="section-queues" class="tab-section hidden bg-white rounded-2xl shadow-md hover:shadow-lg transition-shadow duration-300 border border-gray-100 overflow-hidden">
            <div class="px-6 py-4 border-b border-gray-100 bg-gray-50/50 flex justify-between items-center">
                <h2 class="text-lg font-bold text-gray-900">Virtual Queues</h2>
                <button onclick="openModal('queue-modal')" class="bg-blue-600 hover:bg-blue-700 text-white px-4 py-2 rounded-md text-sm font-bold transition">+ Add Queue</button>
            </div>
            <div class="overflow-x-auto">
                <table class="w-full text-left border-collapse">
                    <thead>
                        <tr class="bg-gray-50 border-b border-gray-100 text-xs uppercase tracking-wider text-gray-500">
                            <th class="p-4 font-semibold">Queue Name</th>
                            <th class="p-4 font-semibold">Status</th>
                            <th class="p-4 font-semibold">Waiting</th>
                            <th class="p-4 font-semibold text-right">Actions</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-gray-100">
                        <% if (typeof queues !== 'undefined' && queues.length === 0) { %>
                            <tr><td colspan="4" class="p-4 text-center text-gray-500">No queues found.</td></tr>
                        <% } else if (typeof queues !== 'undefined') { %>
                            <% queues.forEach(q => { %>
                                <tr class="hover:bg-gray-50">
                                    <td class="p-4 font-medium text-gray-900"><%= q.name %></td>
                                    <td class="p-4">
                                        <span class="px-2 py-1 rounded text-xs font-bold <%= q.isOpen ? 'bg-green-100 text-green-700' : 'bg-red-100 text-red-700' %>">
                                            <%= q.isOpen ? 'OPEN' : 'CLOSED' %>
                                        </span>
                                    </td>
                                    <td class="p-4 text-gray-500"><%= q.tickets.length %></td>
                                    <td class="p-4 text-right space-x-2">
                                        <button onclick="toggleQueue('<%= q.id %>', <%= !q.isOpen %>)" class="text-blue-500 hover:text-blue-700 font-bold text-sm">
                                            <%= q.isOpen ? 'Close Queue' : 'Open Queue' %>
                                        </button>
                                        <button onclick="deleteQueue('<%= q.id %>')" class="text-red-500 hover:text-red-700 font-bold text-sm">Delete</button>
                                    </td>
                                </tr>
                            <% }) %>
                        <% } %>
                    </tbody>
                </table>
            </div>
        </div>

    </main>

    <!-- Modals -->
    <div id="staff-modal" class="fixed inset-0 bg-black bg-opacity-50 flex items-center justify-center hidden z-50">
        <div class="bg-white rounded-xl shadow-lg p-6 w-full max-w-md">
            <h2 class="text-xl font-bold mb-4">Add Staff Member</h2>
            <form onsubmit="event.preventDefault(); createUser('staff');">
                <input type="text" id="staff-name" placeholder="Name" required class="w-full px-3 py-2 border rounded mb-3">
                <input type="email" id="staff-email" placeholder="Email" required class="w-full px-3 py-2 border rounded mb-3">
                <input type="password" id="staff-pass" placeholder="Password" required class="w-full px-3 py-2 border rounded mb-3">
                <select id="staff-role" class="w-full px-3 py-2 border rounded mb-4">
                    <option value="ADMIN">Admin</option>
                    <option value="WARDEN">Warden</option>
                    <option value="FACULTY">Professor (Faculty)</option>
                    <option value="STAFF">Ground Staff</option>
                </select>
                <div class="flex justify-end space-x-2">
                    <button type="button" onclick="closeModal('staff-modal')" class="px-4 py-2 bg-gray-200 rounded font-bold">Cancel</button>
                    <button type="submit" class="px-4 py-2 bg-blue-600 text-white rounded font-bold">Add Staff</button>
                </div>
            </form>
        </div>
    </div>

    <div id="student-modal" class="fixed inset-0 bg-black bg-opacity-50 flex items-center justify-center hidden z-50">
        <div class="bg-white rounded-xl shadow-lg p-6 w-full max-w-md">
            <h2 class="text-xl font-bold mb-4">Add Student</h2>
            <form onsubmit="event.preventDefault(); createUser('student');">
                <input type="text" id="student-name" placeholder="Name" required class="w-full px-3 py-2 border rounded mb-3">
                <input type="email" id="student-email" placeholder="Email" required class="w-full px-3 py-2 border rounded mb-3">
                <input type="password" id="student-pass" placeholder="Password" required class="w-full px-3 py-2 border rounded mb-4">
                <div class="flex justify-end space-x-2">
                    <button type="button" onclick="closeModal('student-modal')" class="px-4 py-2 bg-gray-200 rounded font-bold">Cancel</button>
                    <button type="submit" class="px-4 py-2 bg-blue-600 text-white rounded font-bold">Add Student</button>
                </div>
            </form>
        </div>
    </div>

    <div id="building-modal" class="fixed inset-0 bg-black bg-opacity-50 flex items-center justify-center hidden z-50">
        <div class="bg-white rounded-xl shadow-lg p-6 w-full max-w-md">
            <h2 class="text-xl font-bold mb-4">Add Building</h2>
            <form onsubmit="event.preventDefault(); addBuilding();">
                <input type="text" id="building-name" placeholder="Building Name" required class="w-full px-3 py-2 border rounded mb-3">
                <select id="building-type" class="w-full px-3 py-2 border rounded mb-4">
                    <option value="Hostel">Hostel</option>
                    <option value="Academic">Academic</option>
                </select>
                <div class="flex justify-end space-x-2">
                    <button type="button" onclick="closeModal('building-modal')" class="px-4 py-2 bg-gray-200 rounded font-bold">Cancel</button>
                    <button type="submit" class="px-4 py-2 bg-blue-600 text-white rounded font-bold">Add Building</button>
                </div>
            </form>
        </div>
    </div>

    <div id="announcement-modal" class="fixed inset-0 bg-black bg-opacity-50 flex items-center justify-center hidden z-50">
        <div class="bg-white rounded-xl shadow-lg p-6 w-full max-w-md">
            <h2 class="text-xl font-bold mb-4">Create Announcement</h2>
            <form onsubmit="event.preventDefault(); createAnnouncement();">
                <input type="text" id="ann-title" placeholder="Announcement Title" required class="w-full px-3 py-2 border rounded mb-3">
                <select id="ann-type" class="w-full px-3 py-2 border rounded mb-3">
                    <option value="Notice">Notice</option>
                    <option value="Alert">Alert</option>
                    <option value="News">News</option>
                </select>
                <textarea id="ann-content" placeholder="Content details..." required class="w-full px-3 py-2 border rounded mb-4" rows="4"></textarea>
                
                <div class="flex justify-end space-x-2">
                    <button type="button" onclick="closeModal('announcement-modal')" class="px-4 py-2 bg-gray-200 rounded font-bold">Cancel</button>
                    <button type="submit" class="px-4 py-2 bg-blue-600 text-white rounded font-bold">Post Announcement</button>
                </div>
            </form>
        </div>
    </div>

    <div id="queue-modal" class="fixed inset-0 bg-black bg-opacity-50 flex items-center justify-center hidden z-50">
        <div class="bg-white rounded-xl shadow-lg p-6 w-full max-w-md">
            <h2 class="text-xl font-bold mb-4">Create Virtual Queue</h2>
            <form onsubmit="event.preventDefault(); createQueue();">
                <input type="text" id="queue-name" placeholder="Queue Name (e.g. IT Support)" required class="w-full px-3 py-2 border rounded mb-4">
                
                <div class="flex justify-end space-x-2">
                    <button type="button" onclick="closeModal('queue-modal')" class="px-4 py-2 bg-gray-200 rounded font-bold">Cancel</button>
                    <button type="submit" class="px-4 py-2 bg-blue-600 text-white rounded font-bold">Create Queue</button>
                </div>
            </form>
        </div>
    </div>

    <script>
        function switchTab(tabId) {
            // Hide all sections
            document.querySelectorAll('.tab-section').forEach(el => el.classList.add('hidden'));
            document.querySelectorAll('.tab-section').forEach(el => el.classList.remove('block'));
            
            // Reset all tabs
            const tabs = ['pending', 'staff', 'students', 'buildings', 'complaints', 'all-complaints', 'announcements', 'queues'];
            tabs.forEach(t => {
                const btn = document.getElementById('tab-' + t);
                btn.className = 'border-transparent text-gray-500 hover:text-gray-700 hover:border-gray-300 whitespace-nowrap py-4 px-1 border-b-2 font-medium text-sm transition-colors';
            });
            
            // Show active section
            document.getElementById('section-' + tabId).classList.remove('hidden');
            document.getElementById('section-' + tabId).classList.add('block');
            
            // Active tab styling
            const activeBtn = document.getElementById('tab-' + tabId);
            activeBtn.className = 'border-blue-500 text-blue-600 whitespace-nowrap py-4 px-1 border-b-2 font-medium text-sm transition-colors';
        }

        function openModal(id) { document.getElementById(id).classList.remove('hidden'); }
        function closeModal(id) { document.getElementById(id).classList.add('hidden'); }

        async function createUser(type) {
            const name = document.getElementById(type+'-name').value;
            const email = document.getElementById(type+'-email').value;
            const password = document.getElementById(type+'-pass').value;
            const role = type === 'staff' ? document.getElementById('staff-role').value : 'STUDENT';
            
            try {
                const res = await fetch('/api/admin/users', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ name, email, password, role })
                });
                if(res.ok) window.location.reload();
                else alert('Failed to create user');
            } catch(e) { alert("Network error"); }
        }

        async function deleteUser(id) {
            if(!confirm("Are you sure you want to delete this user?")) return;
            try {
                const res = await fetch(`/api/admin/users/${id}`, { method: 'DELETE' });
                const data = await res.json();
                if(res.ok) window.location.reload();
                else alert(data.error || 'Failed to delete');
            } catch(e) { alert("Network error"); }
        }

        async function addBuilding() {
            const name = document.getElementById('building-name').value;
            const type = document.getElementById('building-type').value;
            
            try {
                const res = await fetch('/api/admin/buildings', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ name, type })
                });
                if(res.ok) window.location.reload();
                else alert('Failed to add building');
            } catch(e) { alert("Network error"); }
        }

        async function deleteBuilding(id) {
            if(!confirm("Are you sure you want to delete this building?")) return;
            try {
                const res = await fetch(`/api/admin/buildings/${id}`, { method: 'DELETE' });
                if(res.ok) window.location.reload();
                else alert('Failed to delete');
            } catch(e) { alert("Network error"); }
        }

        async function handleApproval(userId, action) {
            if(!confirm(`Are you sure you want to ${action.toLowerCase()} this user?`)) return;
            try {
                const res = await fetch(`/api/admin/users/${userId}/approve`, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ action })
                });
                const data = await res.json();
                if(res.ok) {
                    window.location.reload();
                } else {
                    alert(data.error);
                }
            } catch(e) {
                alert("Network error.");
            }
        }

        async function updateComplaintStatus(id, status) {
            const btn = document.querySelector(`button[onclick="updateComplaintStatus('${id}', '${status}')"]`);
            if(btn) { btn.disabled = true; btn.innerText = 'Verifying...'; }
            try {
                const res = await fetch(`/api/staff/complaints/${id}/status`, {
                    method: 'PUT',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ status })
                });
                if(!res.ok) {
                    alert('Failed to update status');
                    if(btn) { btn.disabled = false; btn.innerText = 'Verify & Resolve'; }
                } else {
                    window.location.reload();
                }
            } catch(e) { 
                alert("Network error"); 
                if(btn) { btn.disabled = false; btn.innerText = 'Verify & Resolve'; }
            }
        }

        async function assignStaff(id, staffId) {
            if(!staffId) return;
            try {
                const res = await fetch(`/api/warden/complaints/${id}/assign`, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ staffId })
                });
                if(res.ok) window.location.reload();
                else alert('Failed to assign staff');
            } catch(e) { alert("Network error"); }
        }

        async function createAnnouncement() {
            const title = document.getElementById('ann-title').value;
            const type = document.getElementById('ann-type').value;
            const content = document.getElementById('ann-content').value;
            
            try {
                const res = await fetch('/api/admin/announcements', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ title, type, content })
                });
                if(res.ok) window.location.reload();
                else alert('Failed to create announcement');
            } catch(e) { alert("Network error"); }
        }

        async function deleteAnnouncement(id) {
            if(!confirm("Delete this announcement?")) return;
            try {
                const res = await fetch(`/api/admin/announcements/${id}`, { method: 'DELETE' });
                if(res.ok) window.location.reload();
                else alert('Failed to delete');
            } catch(e) { alert("Network error"); }
        }

        async function saveRemark(complaintId) {
            const remark = document.getElementById(`remark-${complaintId}`).value;
            try {
                const res = await fetch(`/api/warden/complaints/${complaintId}/remark`, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ remark })
                });
                if(res.ok) {
                    alert('Remark saved successfully!');
                } else {
                    alert('Failed to save remark.');
                }
            } catch(e) {
                alert('Network error');
            }
        }

        async function createQueue() {
            const name = document.getElementById('queue-name').value;
            try {
                const res = await fetch('/api/admin/queues', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ name })
                });
                if(res.ok) window.location.reload();
                else alert('Failed to create queue');
            } catch(e) { alert("Network error"); }
        }

        async function toggleQueue(id, isOpen) {
            try {
                const res = await fetch(`/api/admin/queues/${id}`, {
                    method: 'PUT',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ isOpen })
                });
                if(res.ok) window.location.reload();
                else alert('Failed to update queue');
            } catch(e) { alert("Network error"); }
        }

        async function deleteQueue(id) {
            if(!confirm("Delete this queue?")) return;
            try {
                const res = await fetch(`/api/admin/queues/${id}`, { method: 'DELETE' });
                if(res.ok) window.location.reload();
                else alert('Failed to delete');
            } catch(e) { alert("Network error"); }
        }
    </script>
</body>
</html>
