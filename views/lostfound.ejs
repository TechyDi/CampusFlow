<%- include('partials/header') %>

<main class="max-w-6xl mx-auto px-6 py-8">
    <div class="flex justify-between items-center mb-8">
        <div>
            <h1 class="text-3xl font-extrabold text-gray-900 tracking-tight">Lost & Found</h1>
            <p class="text-sm text-gray-500 mt-1">Report lost items or post items you have found on campus.</p>
        </div>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
        <!-- Report Form -->
        <div class="lg:col-span-1">
            <div class="bg-white rounded-xl shadow-md border border-gray-100 p-6 sticky top-6">
                <h2 class="text-lg font-bold text-gray-900 mb-4">Report an Item</h2>
                <form id="lfForm" class="space-y-4">
                    <div>
                        <label class="block text-sm font-medium text-gray-700 mb-1">Type</label>
                        <select id="type" required class="w-full border border-gray-300 rounded-md px-3 py-2 text-sm focus:ring-blue-500 focus:border-blue-500">
                            <option value="LOST">I Lost Something</option>
                            <option value="FOUND">I Found Something</option>
                        </select>
                    </div>
                    <div>
                        <label class="block text-sm font-medium text-gray-700 mb-1">Item Name</label>
                        <input type="text" id="itemName" required placeholder="e.g. Blue Hydroflask" class="w-full border border-gray-300 rounded-md px-3 py-2 text-sm focus:ring-blue-500 focus:border-blue-500">
                    </div>
                    <div>
                        <label class="block text-sm font-medium text-gray-700 mb-1">Images (Up to 5)</label>
                        <input type="file" id="images" accept="image/*" multiple class="w-full border border-gray-300 rounded-md px-3 py-2 text-sm focus:ring-blue-500 focus:border-blue-500">
                    </div>
                    <div>
                        <label class="block text-sm font-medium text-gray-700 mb-1">Location</label>
                        <input type="text" id="location" required placeholder="e.g. Library 2nd Floor" class="w-full border border-gray-300 rounded-md px-3 py-2 text-sm focus:ring-blue-500 focus:border-blue-500">
                    </div>
                    <div>
                        <label class="block text-sm font-medium text-gray-700 mb-1">Description</label>
                        <textarea id="description" required rows="3" class="w-full border border-gray-300 rounded-md px-3 py-2 text-sm focus:ring-blue-500 focus:border-blue-500" placeholder="Details (color, brand, etc.)"></textarea>
                    </div>
                    
                    <button type="submit" id="submitBtn" class="w-full bg-blue-600 text-white font-bold py-2.5 rounded-md hover:bg-blue-700 transition flex justify-center items-center">
                        <span id="btnText">Submit Report</span>
                    </button>
                </form>
            </div>
        </div>

        <!-- Items Feed -->
        <div class="lg:col-span-2">
            <div id="itemsGrid" class="grid grid-cols-1 md:grid-cols-2 gap-4">
                <% if(items.length === 0) { %>
                    <div class="col-span-full bg-gray-50 rounded-lg p-8 text-center border border-dashed border-gray-300">
                        <p class="text-gray-500">No items reported yet.</p>
                    </div>
                <% } else { %>
                    <% items.forEach(item => { 
                        let images = [];
                        try { images = JSON.parse(item.imageUrls || "[]"); } catch(e){}
                    %>
                        <div class="bg-white rounded-lg shadow-sm border border-gray-100 p-5 fade-in relative flex flex-col" id="item-<%= item.id %>">
                            <% if (item.status === 'RESOLVED') { %>
                                <div class="absolute inset-0 bg-white/60 backdrop-blur-[1px] flex items-center justify-center z-20 rounded-lg">
                                    <span class="bg-green-100 text-green-800 text-sm font-bold px-3 py-1 rounded-full shadow-sm border border-green-200">RESOLVED</span>
                                </div>
                            <% } %>
                            
                            <div class="flex justify-between items-start mb-3">
                                <span class="px-2.5 py-1 text-xs font-bold rounded-md <%= item.type === 'LOST' ? 'bg-red-100 text-red-700' : 'bg-green-100 text-green-700' %>">
                                    <%= item.type %>
                                </span>
                                <span class="text-xs text-gray-400"><%= new Date(item.dateReported).toLocaleDateString() %></span>
                            </div>

                            <% if (images.length > 0) { %>
                                <div class="h-32 mb-3 bg-gray-100 rounded-md overflow-hidden relative group">
                                    <div class="flex overflow-x-auto snap-x snap-mandatory w-full h-full pb-2">
                                        <% images.forEach((img, idx) => { %>
                                            <img src="<%= img %>" class="snap-center object-cover w-full h-full flex-shrink-0" alt="Item Image <%= idx+1 %>">
                                        <% }) %>
                                    </div>
                                    <% if (images.length > 1) { %>
                                        <div class="absolute bottom-1 right-1 bg-black/50 text-white text-[10px] px-2 py-0.5 rounded-full"><%= images.length %> Photos</div>
                                    <% } %>
                                </div>
                            <% } %>

                            <h3 class="font-bold text-gray-900 truncate" title="<%= item.itemName %>"><%= item.itemName %></h3>
                            <p class="text-sm text-gray-600 mt-1 line-clamp-2"><%= item.description %></p>
                            
                            <div class="mt-auto pt-4 border-t border-gray-50 flex flex-col space-y-2">
                                <div class="flex items-center text-xs text-gray-500">
                                    <svg class="w-4 h-4 mr-1 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"></path><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"></path></svg>
                                    <%= item.location %>
                                </div>
                                <div class="flex items-center text-xs text-gray-500">
                                    <svg class="w-4 h-4 mr-1 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"></path></svg>
                                    Reported by: <%= item.student.name %>
                                </div>
                            </div>

                            <% if (item.status === 'ACTIVE' && item.studentId === currentUserId) { %>
                                <div class="mt-4 text-right z-10 relative">
                                    <button onclick="resolveItem('<%= item.id %>')" class="text-xs text-blue-600 font-semibold hover:text-blue-800 transition bg-blue-50 px-3 py-1.5 rounded-md hover:bg-blue-100">Mark as Resolved</button>
                                </div>
                            <% } %>
                        </div>
                    <% }) %>
                <% } %>
            </div>
        </div>
    </div>
</main>

<script>
    const form = document.getElementById('lfForm');
    
    form.addEventListener('submit', async (e) => {
        e.preventDefault();
        
        const submitBtn = document.getElementById('submitBtn');
        const btnText = document.getElementById('btnText');
        
        submitBtn.disabled = true;
        btnText.textContent = 'Submitting...';

        try {
            const formData = new FormData();
            formData.append('type', document.getElementById('type').value);
            formData.append('itemName', document.getElementById('itemName').value);
            formData.append('location', document.getElementById('location').value);
            formData.append('description', document.getElementById('description').value);
            
            const files = document.getElementById('images').files;
            for(let i=0; i<files.length; i++) {
                formData.append('images', files[i]);
            }

            const response = await fetch('/api/lost-found', {
                method: 'POST',
                body: formData
            });

            if (response.ok) {
                window.location.reload();
            } else {
                alert("Failed to submit.");
            }
        } catch (error) {
            alert("Network error.");
        } finally {
            submitBtn.disabled = false;
            btnText.textContent = 'Submit Report';
        }
    });

    window.resolveItem = async function(id) {
        if(!confirm("Mark this item as resolved?")) return;

        try {
            const response = await fetch(`/api/lost-found/${id}/resolve`, {
                method: 'PUT'
            });

            if(response.ok) {
                window.location.reload();
            } else {
                alert("Failed to resolve item");
            }
        } catch(e) {
            alert("Network error");
        }
    };
</script>

<%- include('partials/footer') %>
