<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= locals.title ? title : 'CampusFlow' %></title>
    <!-- Include Tailwind CSS via CDN for Level 2 Advanced Styling requirement -->
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        const plan = "<%= locals.subscriptionPlan || 'FREE' %>";
        
        // Premium Theme Palettes overriding Tailwind's default 'blue' class
        let themeColor = {
            50: '#eff6ff', 100: '#dbeafe', 200: '#bfdbfe', 300: '#93c5fd', 400: '#60a5fa',
            500: '#3b82f6', 600: '#2563eb', 700: '#1d4ed8', 800: '#1e40af', 900: '#1e3a8a', 950: '#172554'
        }; // FREE: Default Blue

        if (plan === 'ENTERPRISE') {
            // Luxurious Royal Violet
            themeColor = {
                50: '#faf5ff', 100: '#f3e8ff', 200: '#e9d5ff', 300: '#d8b4fe', 400: '#c084fc',
                500: '#a855f7', 600: '#9333ea', 700: '#7e22ce', 800: '#6b21a8', 900: '#581c87', 950: '#3b0764'
            };
        } else if (plan === 'PRO') {
            // Premium Emerald/Jade
            themeColor = {
                50: '#ecfdf5', 100: '#d1fae5', 200: '#a7f3d0', 300: '#6ee7b7', 400: '#34d399',
                500: '#10b981', 600: '#059669', 700: '#047857', 800: '#065f46', 900: '#064e3b', 950: '#022c22'
            };
        }

        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        blue: themeColor
                    }
                }
            }
        }
    </script>
    <style>
        /* Level 1: Inline/Basic styles and Transitions */
        .fade-in {
            animation: fadeIn 0.5s ease-in;
        }
        @keyframes fadeIn {
            from { opacity: 0; transform: translateY(10px); }
            to { opacity: 1; transform: translateY(0); }
        }
    </style>
</head>
<body class="bg-gray-50 min-h-screen text-gray-800 font-sans flex flex-col">
    <!-- Navbar -->
    <nav class="bg-blue-600 shadow-md text-white px-6 py-4">
        <div class="max-w-7xl mx-auto flex flex-col md:flex-row justify-between items-center w-full gap-4 md:gap-0">
            <!-- Left: Logo -->
            <div class="w-full md:w-auto text-center md:text-left">
                <a href="/" class="text-2xl font-bold tracking-tight">CampusFlow</a>
            </div>

            <!-- Center: Nav Links -->
            <div class="flex flex-1 justify-center flex-wrap items-center gap-1.5 md:gap-3">
                <a href="/" class="px-4 py-2 rounded-lg text-sm font-medium text-white hover:bg-white/10 hover:shadow-sm transition-all duration-200">Home</a>
                <% if (!locals.user && (locals.subscriptionPlan === 'PRO' || locals.subscriptionPlan === 'ENTERPRISE')) { %>
                    <a href="/announcements" class="px-4 py-2 rounded-lg text-sm font-medium text-white hover:bg-white/10 hover:shadow-sm transition-all duration-200">Announcements</a>
                <% } %>
                <% if (locals.user) { %>
                    <% if (user.role === 'SUPER_ADMIN') { %>
                        <a href="/superadmin" class="px-4 py-2 rounded-lg text-sm font-bold text-yellow-300 hover:bg-white/10 hover:text-yellow-100 transition-all duration-200 shadow-sm ml-1">Super Admin</a>
                    <% } else if (user.role === 'ADMIN') { %>
                        <% if (locals.subscriptionPlan === 'PRO' || locals.subscriptionPlan === 'ENTERPRISE') { %>
                            <a href="/announcements" class="px-4 py-2 rounded-lg text-sm font-medium text-white hover:bg-white/10 hover:shadow-sm transition-all duration-200">Announcements</a>
                        <% } %>
                        <a href="/admin" class="px-4 py-2 rounded-lg text-sm font-bold text-yellow-300 hover:bg-white/10 hover:text-yellow-100 transition-all duration-200 shadow-sm ml-1">Admin Panel</a>
                    <% } else { %>
                        <% if (locals.subscriptionPlan === 'PRO' || locals.subscriptionPlan === 'ENTERPRISE') { %>
                            <a href="/announcements" class="px-4 py-2 rounded-lg text-sm font-medium text-white hover:bg-white/10 hover:shadow-sm transition-all duration-200">Announcements</a>
                        <% } %>
                        
                        <% if (user.role === 'STUDENT') { %>
                            <% if (locals.subscriptionPlan === 'ENTERPRISE') { %>
                                <a href="/queues" class="px-4 py-2 rounded-lg text-sm font-medium text-white hover:bg-white/10 hover:shadow-sm transition-all duration-200">Virtual Queues</a>
                            <% } %>
                            <% if (locals.subscriptionPlan === 'PRO' || locals.subscriptionPlan === 'ENTERPRISE') { %>
                                <a href="/marketplace" class="px-4 py-2 rounded-lg text-sm font-medium text-white hover:bg-white/10 hover:shadow-sm transition-all duration-200">Marketplace</a>
                                <a href="/lost-and-found" class="px-4 py-2 rounded-lg text-sm font-medium text-white hover:bg-white/10 hover:shadow-sm transition-all duration-200">Lost & Found</a>
                            <% } %>
                        <% } %>
                        
                        <% if (user.role === 'STUDENT' || user.role === 'FACULTY') { %>
                            <a href="/attendance" class="px-4 py-2 rounded-lg text-sm font-medium text-white hover:bg-white/10 hover:shadow-sm transition-all duration-200">Smart Attendance</a>
                        <% } %>
                        
                        <a href="/complaints" class="px-4 py-2 rounded-lg text-sm font-medium text-white hover:bg-white/10 hover:shadow-sm transition-all duration-200">Dashboard</a>
                        <% if (user.role === 'WARDEN') { %>
                            <a href="/warden" class="px-4 py-2 rounded-lg text-sm font-bold text-yellow-300 hover:bg-white/10 hover:text-yellow-100 transition-all duration-200 shadow-sm ml-1">Warden Portal</a>
                        <% } %>
                        
                        <% if (user.role === 'STAFF') { %>
                            <a href="/staff" class="px-4 py-2 rounded-lg text-sm font-bold text-yellow-300 hover:bg-white/10 hover:text-yellow-100 transition-all duration-200 shadow-sm ml-1">Staff Tasks</a>
                        <% } %>
                        <% if (user.role === 'FACULTY') { %>
                            <a href="/faculty" class="px-4 py-2 rounded-lg text-sm font-bold text-yellow-300 hover:bg-white/10 hover:text-yellow-100 transition-all duration-200 shadow-sm ml-1">Faculty Portal</a>
                        <% } %>
                    <% } %>
                <% } %>
            </div>

            <!-- Right: Actions -->
            <div class="flex items-center gap-4 w-full md:w-auto justify-center md:justify-end">
                <% if (locals.user) { %>
                    <div class="relative">
                        <button onclick="document.getElementById('notif-dropdown').classList.toggle('hidden')" class="flex items-center justify-center text-white hover:text-blue-200 transition focus:outline-none" title="Notifications">
                            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 17h5l-1.405-1.405A2.032 2.032 0 0118 14.158V11a6.002 6.002 0 00-4-5.659V5a2 2 0 10-4 0v.341C7.67 6.165 6 8.388 6 11v3.159c0 .538-.214 1.055-.595 1.436L4 17h5m6 0v1a3 3 0 11-6 0v-1m6 0H9"></path></svg>
                            <% if (locals.unreadCount && locals.unreadCount > 0) { %>
                                <span id="nav-notification-badge" class="absolute -top-1 -right-1 bg-red-500 text-white text-[10px] font-bold px-1.5 py-0.5 rounded-full border border-blue-600"><%= unreadCount %></span>
                            <% } %>
                        </button>
                        
                        <!-- Dropdown -->
                        <div id="notif-dropdown" class="hidden absolute right-0 mt-3 w-72 bg-white rounded-md shadow-xl border border-gray-200 z-50 overflow-hidden text-left">
                            <div class="px-4 py-3 bg-gray-50 border-b border-gray-100 font-bold text-gray-700 text-sm flex justify-between items-center">
                                Notifications
                                <button onclick="markAllNotifsRead()" class="text-xs text-blue-600 font-normal hover:underline">Mark all read</button>
                            </div>
                            <div class="max-h-80 overflow-y-auto">
                                <% if (locals.globalNotifications && locals.globalNotifications.length > 0) { %>
                                    <% globalNotifications.forEach(n => { %>
                                        <div class="block px-4 py-3 hover:bg-gray-50 border-b border-gray-100 transition <%= n.isRead ? 'opacity-60' : 'bg-blue-50/30' %>">
                                            <p class="text-sm font-bold text-gray-900 mb-1"><%= n.title %></p>
                                            <p class="text-xs text-gray-600 mb-2"><%= n.message %></p>
                                            <div class="flex justify-between items-center mt-2">
                                                <span class="text-[10px] text-gray-400"><%= new Date(n.createdAt).toLocaleDateString() %></span>
                                                <button onclick="readNotif('<%= n.id %>', '<%= n.link %>')" class="text-xs font-bold text-blue-600 hover:text-blue-800">View</button>
                                            </div>
                                        </div>
                                    <% }) %>
                                <% } else { %>
                                    <div class="px-4 py-6 text-center text-gray-500 text-sm">No new notifications.</div>
                                <% } %>
                            </div>
                        </div>
                    </div>

                    <div class="flex flex-row items-center space-x-4 border-l border-blue-400 pl-4 ml-2">
                        <div class="flex flex-col items-end leading-tight">
                            <span class="text-blue-200 text-[10px] font-bold uppercase tracking-wider">Role</span>
                            <span class="text-white text-xs font-bold uppercase tracking-wider"><%= user.role %></span>
                        </div>
                        <a href="/logout" class="bg-white/10 text-white border border-white/30 px-3 py-1.5 rounded-md text-sm font-medium hover:bg-white/20 transition-all duration-200 shadow-sm">Log Out</a>
                    </div>
                <% } else { %>
                    <a href="/login" class="bg-white text-blue-600 px-4 py-2 rounded-md font-bold hover:bg-gray-100 transition shadow-sm">Sign In</a>
                <% } %>
            </div>
        </div>
    </nav>
    <script>
        // Notification click handler
        async function readNotif(id, link) {
            try {
                await fetch(`/api/notifications/${id}/read`, { method: 'POST' });
            } catch (e) {
                console.error(e);
            }
            if (link) {
                window.location.href = link;
            } else {
                window.location.reload();
            }
        }

        async function markAllNotifsRead() {
            try {
                await fetch(`/api/notifications/read-all`, { method: 'POST' });
            } catch (e) {
                console.error(e);
            }
            window.location.reload();
        }
        
        // Hide dropdown if clicked outside
        document.addEventListener('click', function(event) {
            const dropdown = document.getElementById('notif-dropdown');
            const button = dropdown ? dropdown.previousElementSibling : null;
            if (dropdown && !dropdown.contains(event.target) && !button.contains(event.target)) {
                dropdown.classList.add('hidden');
            }
        });
    </script>
    <main class="flex-grow">
