<div class="bg-white rounded-xl shadow-2xl max-w-2xl w-full p-8 border border-gray-100 relative">
    <% if (locals.isSuperAdminView) { %>
        <a href="/superadmin" class="absolute top-6 right-6 text-gray-400 hover:text-gray-600 font-bold text-sm flex items-center">
            <svg class="w-4 h-4 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"></path></svg>
            Back to Dashboard
        </a>
    <% } %>

    <div class="mb-8 text-center">
        <h1 class="text-3xl font-black text-gray-900 tracking-tight">
            <%= locals.isSuperAdminView ? 'Register New Institution' : 'Onboard Your Institution' %>
        </h1>
        <p class="text-gray-500 mt-2">
            <%= locals.isSuperAdminView ? 'Create an institution directly from the Super Admin panel.' : 'Set up CampusFlow in easy steps.' %>
        </p>
        
        <!-- Progress Bar -->
        <div class="flex items-center justify-between mt-6 max-w-sm mx-auto relative">
            <div class="absolute left-0 top-1/2 -translate-y-1/2 w-full h-1 bg-gray-200 z-0"></div>
            <div id="progress-fill" class="absolute left-0 top-1/2 -translate-y-1/2 h-1 bg-blue-600 z-0 transition-all duration-300" style="width: 0%;"></div>
            
            <div class="step-indicator w-8 h-8 rounded-full flex items-center justify-center font-bold text-sm bg-blue-600 text-white z-10 ring-4 ring-white" id="ind-1">1</div>
            <div class="step-indicator w-8 h-8 rounded-full flex items-center justify-center font-bold text-sm bg-gray-200 text-gray-500 z-10 ring-4 ring-white" id="ind-2">2</div>
            <div class="step-indicator w-8 h-8 rounded-full flex items-center justify-center font-bold text-sm bg-gray-200 text-gray-500 z-10 ring-4 ring-white" id="ind-3">3</div>
            <div class="step-indicator w-8 h-8 rounded-full flex items-center justify-center font-bold text-sm bg-gray-200 text-gray-500 z-10 ring-4 ring-white" id="ind-4">4</div>
            <% if (!locals.isSuperAdminView) { %>
                <div class="step-indicator w-8 h-8 rounded-full flex items-center justify-center font-bold text-sm bg-gray-200 text-gray-500 z-10 ring-4 ring-white" id="ind-5">5</div>
            <% } %>
        </div>
    </div>

    <form id="onboarding-form" onsubmit="event.preventDefault(); submitForm();">
        
        <div id="step-error" class="hidden bg-red-50 text-red-600 font-bold p-3 rounded-md mb-6 border border-red-200"></div>

        <!-- STEP 1: Institution Details -->
        <div id="step-1" class="step-active">
            <h2 class="text-xl font-bold mb-4">1. Institution Details</h2>
            <label class="block text-sm font-bold text-gray-700 mb-1">Institution Name</label>
            <input type="text" id="inst-name" required class="w-full px-4 py-2 border rounded-md focus:ring-blue-500 focus:border-blue-500 mb-4" placeholder="e.g. Stanford University">
            <button type="button" onclick="nextStep(1)" class="w-full bg-blue-600 text-white font-bold py-3 px-4 rounded hover:bg-blue-700 transition">Continue</button>
        </div>

        <!-- STEP 2: Choose Plan -->
        <div id="step-2" class="step-hidden">
            <h2 class="text-xl font-bold mb-4">2. Select Your Plan</h2>
            <div class="space-y-4 mb-6">
                <label class="block cursor-pointer">
                    <input type="radio" name="plan" value="FREE" class="peer hidden" onchange="updateBuildingLimit(2)" required>
                    <div class="p-4 border-2 rounded-lg peer-checked:border-blue-600 peer-checked:bg-blue-50 hover:bg-gray-50 transition">
                        <div class="flex justify-between items-center mb-1"><span class="font-bold text-lg">FREE</span><span class="font-bold">$0/mo</span></div>
                        <p class="text-sm text-gray-500">Max 2 Buildings. Basic CMMS and Live Attendance.</p>
                    </div>
                </label>
                <label class="block cursor-pointer">
                    <input type="radio" name="plan" value="PRO" class="peer hidden" onchange="updateBuildingLimit(10)">
                    <div class="p-4 border-2 rounded-lg peer-checked:border-blue-600 peer-checked:bg-blue-50 hover:bg-gray-50 transition">
                        <div class="flex justify-between items-center mb-1"><span class="font-bold text-lg text-blue-600">PRO</span><span class="font-bold">$99/mo</span></div>
                        <p class="text-sm text-gray-500">Max 10 Buildings. Includes Marketplace, Announcements & L&F.</p>
                    </div>
                </label>
                <label class="block cursor-pointer">
                    <input type="radio" name="plan" value="ENTERPRISE" class="peer hidden" onchange="updateBuildingLimit(999)">
                    <div class="p-4 border-2 rounded-lg peer-checked:border-blue-600 peer-checked:bg-blue-50 hover:bg-gray-50 transition">
                        <div class="flex justify-between items-center mb-1"><span class="font-bold text-lg text-purple-600">ENTERPRISE</span><span class="font-bold">$299/mo</span></div>
                        <p class="text-sm text-gray-500">Unlimited Buildings. Full suite including Virtual Queues.</p>
                    </div>
                </label>
            </div>
            <div class="flex space-x-4">
                <button type="button" onclick="prevStep(2)" class="w-1/3 bg-gray-200 text-gray-700 font-bold py-3 px-4 rounded hover:bg-gray-300 transition">Back</button>
                <button type="button" onclick="nextStep(2)" class="w-2/3 bg-blue-600 text-white font-bold py-3 px-4 rounded hover:bg-blue-700 transition">Continue</button>
            </div>
        </div>

        <!-- STEP 3: Buildings -->
        <div id="step-3" class="step-hidden">
            <h2 class="text-xl font-bold mb-4">3. Setup Buildings/Campuses</h2>
            <p class="text-sm text-gray-500 mb-4" id="building-limit-text">Your plan allows up to X buildings.</p>
            
            <div id="building-list" class="space-y-3 mb-4">
                <!-- Dynamic inputs -->
            </div>
            
            <button type="button" onclick="addBuildingInput()" id="add-building-btn" class="text-blue-600 font-bold text-sm mb-6 flex items-center">+ Add Another Building</button>

            <div class="flex space-x-4">
                <button type="button" onclick="prevStep(3)" class="w-1/3 bg-gray-200 text-gray-700 font-bold py-3 px-4 rounded hover:bg-gray-300 transition">Back</button>
                <button type="button" onclick="nextStep(3)" class="w-2/3 bg-blue-600 text-white font-bold py-3 px-4 rounded hover:bg-blue-700 transition">Continue</button>
            </div>
        </div>

        <!-- STEP 4: Initial Staff Accounts -->
        <div id="step-4" class="step-hidden">
            <h2 class="text-xl font-bold mb-4">4. Initial Staff Accounts</h2>
            <p class="text-sm text-gray-500 mb-4">Create your first accounts. You must create at least one ADMIN.</p>
            
            <div id="user-list" class="space-y-3 mb-4">
                <!-- Dynamic inputs -->
            </div>
            
            <button type="button" onclick="addUserInput()" id="add-user-btn" class="text-blue-600 font-bold text-sm mb-6 flex items-center">+ Add Another User</button>

            <div class="flex space-x-4">
                <button type="button" onclick="prevStep(4)" class="w-1/3 bg-gray-200 text-gray-700 font-bold py-3 px-4 rounded hover:bg-gray-300 transition">Back</button>
                <% if (locals.isSuperAdminView) { %>
                    <!-- For Super Admin, step 4 is the final step -->
                    <button type="submit" id="submit-btn" class="w-2/3 bg-green-600 text-white font-bold py-3 px-4 rounded hover:bg-green-700 transition flex justify-center items-center">
                        <span id="submit-text">Create Institution</span>
                        <svg id="submit-spinner" class="animate-spin -ml-1 mr-3 h-5 w-5 text-white hidden" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24"><circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle><path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path></svg>
                    </button>
                <% } else { %>
                    <button type="button" onclick="nextStep(4)" class="w-2/3 bg-blue-600 text-white font-bold py-3 px-4 rounded hover:bg-blue-700 transition">Continue to Payment</button>
                <% } %>
            </div>
        </div>

        <% if (!locals.isSuperAdminView) { %>
            <!-- STEP 5: Payment Gateway (Simulated) -->
            <div id="step-5" class="step-hidden">
                <h2 class="text-xl font-bold mb-4">5. Payment Details</h2>
                <p class="text-sm text-gray-500 mb-4">This is a simulated payment gateway. No real charges will be made.</p>
                
                <div class="bg-gray-50 p-4 rounded border mb-4">
                    <div class="flex justify-between font-bold mb-2">
                        <span id="summary-plan-name">FREE Plan</span>
                        <span id="summary-plan-price">$0.00</span>
                    </div>
                </div>

                <div id="credit-card-section" class="hidden">
                    <label class="block text-sm font-bold text-gray-700 mb-1">Card Number</label>
                    <input type="text" id="cc-number" placeholder="4242 4242 4242 4242" maxlength="19" class="w-full px-4 py-2 border rounded-md mb-4 bg-gray-50 font-mono text-gray-600" oninput="this.value = this.value.replace(/[^0-9 ]/g, '')">
                    
                    <div class="flex space-x-4 mb-6">
                        <div class="w-1/2">
                            <label class="block text-sm font-bold text-gray-700 mb-1">Expiry</label>
                            <input type="text" id="cc-expiry" placeholder="MM/YY" maxlength="5" class="w-full px-4 py-2 border rounded-md bg-gray-50" oninput="this.value = this.value.replace(/[^0-9\/]/g, ''); if(this.value.length === 2 && !this.value.includes('/')) this.value += '/';">
                        </div>
                        <div class="w-1/2">
                            <label class="block text-sm font-bold text-gray-700 mb-1">CVC</label>
                            <input type="text" id="cc-cvc" placeholder="123" maxlength="3" class="w-full px-4 py-2 border rounded-md bg-gray-50" oninput="this.value = this.value.replace(/[^0-9]/g, '')">
                        </div>
                    </div>
                </div>
                
                <div class="flex space-x-4">
                    <button type="button" onclick="prevStep(5)" class="w-1/3 bg-gray-200 text-gray-700 font-bold py-3 px-4 rounded hover:bg-gray-300 transition">Back</button>
                    <button type="submit" id="submit-btn" class="w-2/3 bg-green-600 text-white font-bold py-3 px-4 rounded hover:bg-green-700 transition flex justify-center items-center">
                        <span id="submit-text">Complete Registration</span>
                        <svg id="submit-spinner" class="animate-spin -ml-1 mr-3 h-5 w-5 text-white hidden" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24"><circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle><path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path></svg>
                    </button>
                </div>
            </div>
        <% } %>
        
        <div id="error-msg" class="text-red-600 text-sm mt-4 font-bold hidden text-center"></div>

    </form>
</div>

<!-- Success Modal (Only for regular onboarding) -->
<% if (!locals.isSuperAdminView) { %>
<div id="success-modal" class="fixed inset-0 bg-black bg-opacity-50 flex items-center justify-center hidden z-50">
    <div class="bg-white p-8 rounded-xl shadow-2xl text-center max-w-sm">
        <div class="w-16 h-16 bg-green-100 text-green-600 rounded-full flex items-center justify-center mx-auto mb-4">
            <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path></svg>
        </div>
        <h2 class="text-2xl font-bold mb-2">Registration Successful!</h2>
        <p class="text-gray-600 mb-6">Your institution has been created. You can now log in as the Administrator.</p>
        <a href="/login" class="block w-full bg-blue-600 text-white font-bold py-3 rounded-lg hover:bg-blue-700 transition">Proceed to Login</a>
    </div>
</div>
<% } %>

<style>
    .step-hidden { display: none; }
    .step-active { display: block; animation: fadeIn 0.5s; }
    @keyframes fadeIn { from { opacity: 0; transform: translateY(10px); } to { opacity: 1; transform: translateY(0); } }
</style>

<script>
    let currentStep = 1;
    let maxBuildings = 2;
    let buildingCount = 0;
    const isSuperAdminView = <%= locals.isSuperAdminView ? 'true' : 'false' %>;
    
    function showError(msg) {
        const errDiv = document.getElementById('step-error');
        errDiv.innerText = msg;
        errDiv.classList.remove('hidden');
    }
    
    function hideError() {
        document.getElementById('step-error').classList.add('hidden');
    }

    function nextStep(step) {
        hideError();
        if (step === 1 && !document.getElementById('inst-name').value.trim()) return showError('Institution Name is required');
        if (step === 2 && !document.querySelector('input[name="plan"]:checked')) return showError('Please select a subscription plan');
        if (step === 3) {
            const bEntries = document.querySelectorAll('.building-entry');
            bEntries.forEach(entry => {
                const name = entry.querySelector('.building-name').value.trim();
                if (!name) { entry.remove(); buildingCount--; }
            });
            const remaining = document.querySelectorAll('.building-name');
            if (remaining.length === 0) {
                addBuildingInput();
                return showError('At least one building name is required');
            }
        }
        if (step === 4) {
            const uEntries = document.querySelectorAll('.user-entry');
            for (let i = 0; i < uEntries.length; i++) {
                const entry = uEntries[i];
                const name = entry.querySelector('.user-name').value.trim();
                const email = entry.querySelector('.user-email').value.trim();
                const pass = entry.querySelector('.user-password').value.trim();
                if (!name && !email && !pass) {
                    entry.remove();
                } else if (!name || !email || !pass) {
                    return showError('All user details are required for every added user row');
                }
            }
            
            const remainingRoles = document.querySelectorAll('.user-role');
            if (remainingRoles.length === 0) {
                addUserInput();
                return showError('You must create at least one ADMIN account');
            }
            
            let hasAdmin = false;
            for (let i = 0; i < remainingRoles.length; i++) {
                if (remainingRoles[i].value === 'ADMIN') hasAdmin = true;
            }
            if (!hasAdmin) return showError('You must create at least one ADMIN account');
            
            if (!isSuperAdminView) {
                const plan = document.querySelector('input[name="plan"]:checked').value;
                document.getElementById('summary-plan-name').innerText = plan + " Plan";
                if (plan === 'FREE') {
                    document.getElementById('summary-plan-price').innerText = "$0.00";
                    document.getElementById('credit-card-section').classList.add('hidden');
                } else if (plan === 'PRO') {
                    document.getElementById('summary-plan-price').innerText = "$99.00/mo";
                    document.getElementById('credit-card-section').classList.remove('hidden');
                } else {
                    document.getElementById('summary-plan-price').innerText = "$299.00/mo";
                    document.getElementById('credit-card-section').classList.remove('hidden');
                }
            }
        }

        document.getElementById(`step-${step}`).classList.remove('step-active');
        document.getElementById(`step-${step}`).classList.add('step-hidden');
        document.getElementById(`step-${step+1}`).classList.remove('step-hidden');
        document.getElementById(`step-${step+1}`).classList.add('step-active');
        
        updateProgress(step + 1);
    }

    function prevStep(step) {
        hideError();
        document.getElementById(`step-${step}`).classList.remove('step-active');
        document.getElementById(`step-${step}`).classList.add('step-hidden');
        document.getElementById(`step-${step-1}`).classList.remove('step-hidden');
        document.getElementById(`step-${step-1}`).classList.add('step-active');
        
        updateProgress(step - 1);
    }

    function updateProgress(step) {
        const totalSteps = isSuperAdminView ? 3 : 4; // since array goes 0 to N-1
        document.getElementById('progress-fill').style.width = ((step - 1) / totalSteps) * 100 + '%';
        for (let i = 1; i <= (isSuperAdminView ? 4 : 5); i++) {
            const ind = document.getElementById(`ind-${i}`);
            if(ind) {
                if (i <= step) {
                    ind.classList.remove('bg-gray-200', 'text-gray-500');
                    ind.classList.add('bg-blue-600', 'text-white');
                } else {
                    ind.classList.add('bg-gray-200', 'text-gray-500');
                    ind.classList.remove('bg-blue-600', 'text-white');
                }
            }
        }
    }

    function updateBuildingLimit(limit) {
        maxBuildings = limit;
        document.getElementById('building-limit-text').innerText = `Your plan allows up to ${limit === 999 ? 'Unlimited' : limit} buildings.`;
        document.getElementById('building-list').innerHTML = '';
        buildingCount = 0;
        addBuildingInput();
        document.getElementById('add-building-btn').classList.remove('hidden');
    }

    function addBuildingInput() {
        if (buildingCount >= maxBuildings) {
            showError(`Maximum buildings reached for your plan.`);
            return;
        }
        buildingCount++;
        const div = document.createElement('div');
        div.className = "flex space-x-2 items-center mb-2 building-entry";
        div.innerHTML = `
            <input type="text" placeholder="Building Name (e.g. North Hostel)" class="building-name w-3/5 px-3 py-2 border rounded text-sm focus:ring-blue-500" required>
            <select class="building-type w-1/4 px-3 py-2 border rounded text-sm bg-gray-50">
                <option value="Hostel">Hostel</option>
                <option value="Academic">Academic</option>
            </select>
            <button type="button" onclick="this.closest('.building-entry').remove(); buildingCount--;" class="text-red-500 hover:text-red-700 bg-red-50 p-2 rounded w-auto" title="Remove Building">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"></path></svg>
            </button>
        `;
        document.getElementById('building-list').appendChild(div);
        if (buildingCount >= maxBuildings) {
            document.getElementById('add-building-btn').classList.add('hidden');
        }
    }
    
    updateBuildingLimit(2);

    let userCount = 0;
    function addUserInput() {
        userCount++;
        const div = document.createElement('div');
        div.className = "flex space-x-2 border-b pb-3 mb-3 user-entry items-center";
        div.innerHTML = `
            <div class="flex-1 space-y-2">
                <input type="text" placeholder="Name" class="user-name w-full px-3 py-2 border rounded text-sm focus:ring-blue-500" required>
                <input type="email" placeholder="Email" class="user-email w-full px-3 py-2 border rounded text-sm focus:ring-blue-500" required>
                <input type="password" placeholder="Password" class="user-password w-full px-3 py-2 border rounded text-sm focus:ring-blue-500" required>
            </div>
            <div class="w-1/3 flex items-center space-x-2">
                <select class="user-role w-full px-3 py-2 border rounded text-sm bg-gray-50">
                    <option value="ADMIN" ${userCount === 1 ? 'selected' : ''}>Admin</option>
                    <option value="WARDEN">Warden</option>
                    <option value="FACULTY">Professor (Faculty)</option>
                    <option value="STAFF">Ground Staff</option>
                </select>
                <button type="button" onclick="this.closest('.user-entry').remove()" class="text-red-500 hover:text-red-700 bg-red-50 p-2 rounded" title="Remove User">
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"></path></svg>
                </button>
            </div>
        `;
        document.getElementById('user-list').appendChild(div);
    }
    
    addUserInput();

    async function submitForm() {
        const btn = document.getElementById('submit-btn');
        const txt = document.getElementById('submit-text');
        const spin = document.getElementById('submit-spinner');
        const errDiv = document.getElementById('error-msg');
        
        errDiv.classList.add('hidden');
        btn.disabled = true;
        txt.classList.add('hidden');
        spin.classList.remove('hidden');

        const institutionName = document.getElementById('inst-name').value;
        const plan = document.querySelector('input[name="plan"]:checked').value;
        
        const userNames = document.querySelectorAll('.user-name');
        const userEmails = document.querySelectorAll('.user-email');
        const userPasswords = document.querySelectorAll('.user-password');
        const userRoles = document.querySelectorAll('.user-role');
        let users = [];
        
        for (let i = 0; i < userNames.length; i++) {
            if (userNames[i].value.trim()) {
                users.push({ 
                    name: userNames[i].value.trim(), 
                    email: userEmails[i].value.trim(),
                    password: userPasswords[i].value,
                    role: userRoles[i].value
                });
            }
        }
        
        const buildingNames = document.querySelectorAll('.building-name');
        const buildingTypes = document.querySelectorAll('.building-type');
        let buildings = [];
        for (let i = 0; i < buildingNames.length; i++) {
            if (buildingNames[i].value.trim()) {
                buildings.push({ name: buildingNames[i].value.trim(), type: buildingTypes[i].value });
            }
        }

        if (!isSuperAdminView) {
            await new Promise(r => setTimeout(r, 1500));
        }

        try {
            const response = await fetch('/api/onboarding/register-institution', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({
                    institutionName, plan, buildings: JSON.stringify(buildings), users: JSON.stringify(users)
                })
            });
            
            const result = await response.json();
            
            if (response.ok) {
                if (isSuperAdminView) {
                    window.location.href = '/superadmin';
                } else {
                    document.getElementById('success-modal').classList.remove('hidden');
                }
            } else {
                throw new Error(result.error || 'Registration failed');
            }
        } catch (e) {
            errDiv.innerText = e.message;
            errDiv.classList.remove('hidden');
            btn.disabled = false;
            txt.classList.remove('hidden');
            spin.classList.add('hidden');
        }
    }
</script>
