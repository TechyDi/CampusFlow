// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db?connection_limit=1"
}

// ----------------------------------------------------------------------
// CORE SAAS MODULE (Multi-Tenancy)
// ----------------------------------------------------------------------

model Institution {
  id               String   @id @default(uuid())
  name             String
  subdomain        String   @unique
  subscriptionPlan String   @default("FREE") // FREE, PRO, ENTERPRISE
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  // Relations
  users            User[]
  buildings        Building[]
  categories       Category[]
  complaints       Complaint[]
  announcements    Announcement[]
  lostItems        LostItem[]
  serviceQueues    ServiceQueue[]
  marketItems      MarketItem[]
  courses          Course[]
}

model User {
  id             String   @id @default(uuid())
  institutionId  String
  name           String
  email          String   @unique
  passwordHash   String
  role           String   @default("STUDENT") // STUDENT, FACULTY, STAFF, ADMIN, SUPER_ADMIN
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  // Relations
  institution    Institution @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  complaints     Complaint[] @relation("StudentComplaints")
  assignedTasks  Complaint[]  @relation("StaffAssignments")
  logs           ComplaintLog[]
  lostItems      LostItem[]
  queueTickets   QueueTicket[]
  marketItems    MarketItem[] @relation("SellerRelation")
  purchases      MarketItem[] @relation("BuyerRelation")
  attendance     AttendanceRecord[]
  messagesSent   Message[]    @relation("SenderRelation")
  messagesRcvd   Message[]    @relation("ReceiverRelation")
}

model Building {
  id            String   @id @default(uuid())
  institutionId String
  name          String
  type          String   // e.g., Hostel, Academic, Admin
  createdAt     DateTime @default(now())

  // Relations
  institution   Institution @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  complaints    Complaint[]
}

// ----------------------------------------------------------------------
// CMMS MODULE (Phase 1)
// ----------------------------------------------------------------------

model Category {
  id            String   @id @default(uuid())
  institutionId String
  name          String   // e.g., Plumbing, Electrical, IT
  createdAt     DateTime @default(now())

  // Relations
  institution   Institution @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  complaints    Complaint[]
}

model Complaint {
  id              String         @id @default(uuid())
  institutionId   String
  studentId       String
  categoryId      String
  buildingId      String
  roomNumber      String?
  title           String
  description     String         
  status          String         @default("OPEN") // OPEN, ASSIGNED, IN_PROGRESS, RESOLVED, CLOSED
  assignedStaffId String?
  aiTags          String?        // JSON or comma separated string for AI categorization
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  // Relations
  institution     Institution    @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  student         User           @relation("StudentComplaints", fields: [studentId], references: [id])
  category        Category       @relation(fields: [categoryId], references: [id])
  building        Building       @relation(fields: [buildingId], references: [id])
  assignedStaff   User?          @relation("StaffAssignments", fields: [assignedStaffId], references: [id])
  logs            ComplaintLog[]
}

model ComplaintLog {
  id          String   @id @default(uuid())
  complaintId String
  userId      String   // The person who made the change
  action      String   // e.g., "Status changed from OPEN to ASSIGNED"
  timestamp   DateTime @default(now())

  // Relations
  complaint   Complaint @relation(fields: [complaintId], references: [id], onDelete: Cascade)
  user        User      @relation(fields: [userId], references: [id])
}

// ----------------------------------------------------------------------
// ANNOUNCEMENTS MODULE (Phase 2)
// ----------------------------------------------------------------------

model Announcement {
  id            String      @id @default(uuid())
  institutionId String
  title         String
  content       String
  datePosted    DateTime    @default(now())
  type          String      // e.g. "Event", "Notice", "Holiday"
  
  institution   Institution @relation(fields: [institutionId], references: [id], onDelete: Cascade)
}

// ----------------------------------------------------------------------
// LOST & FOUND MODULE (Phase 5)
// ----------------------------------------------------------------------

model LostItem {
  id            String      @id @default(uuid())
  institutionId String
  studentId     String
  type          String      // "LOST" or "FOUND"
  itemName      String
  description   String
  imageUrls     String      @default("[]") // JSON stringified array of URLs
  location      String      // Where it was lost/found
  dateReported  DateTime    @default(now())
  status        String      @default("ACTIVE") // ACTIVE, RESOLVED
  
  institution   Institution @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  student       User        @relation(fields: [studentId], references: [id])
}

// ----------------------------------------------------------------------
// QUEUE MODULE (Phase 6)
// ----------------------------------------------------------------------

model ServiceQueue {
  id            String        @id @default(uuid())
  institutionId String
  name          String
  isOpen        Boolean       @default(true)
  
  institution   Institution   @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  tickets       QueueTicket[]
}

model QueueTicket {
  id            String        @id @default(uuid())
  queueId       String
  studentId     String
  status        String        @default("WAITING") // WAITING, SERVED, CANCELLED
  joinedAt      DateTime      @default(now())
  
  queue         ServiceQueue  @relation(fields: [queueId], references: [id], onDelete: Cascade)
  student       User          @relation(fields: [studentId], references: [id])
}

// ----------------------------------------------------------------------
// MARKETPLACE MODULE (Phase 7)
// ----------------------------------------------------------------------

model MarketItem {
  id            String      @id @default(uuid())
  institutionId String
  studentId     String
  title         String
  description   String
  price         Float
  imageUrls     String      @default("[]") // JSON stringified array of URLs
  condition     String      // e.g. "New", "Good", "Used"
  contactInfo   String      // e.g. "Text me at 555-1234"
  status        String      @default("AVAILABLE") // AVAILABLE, PENDING, SOLD
  buyerId       String?     // Tracks the buyer
  datePosted    DateTime    @default(now())
  
  institution   Institution @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  seller        User        @relation("SellerRelation", fields: [studentId], references: [id])
  buyer         User?       @relation("BuyerRelation", fields: [buyerId], references: [id])
}

model Message {
  id          String   @id @default(uuid())
  senderId    String
  receiverId  String
  content     String
  isRead      Boolean  @default(false)
  createdAt   DateTime @default(now())

  sender      User     @relation("SenderRelation", fields: [senderId], references: [id], onDelete: Cascade)
  receiver    User     @relation("ReceiverRelation", fields: [receiverId], references: [id], onDelete: Cascade)
}

// ---------------------------------------------------------------------------
// Phase 8: Smart Attendance
// ---------------------------------------------------------------------------

model Course {
  id            String   @id @default(uuid())
  institutionId String
  code          String   // e.g. "CS101"
  name          String   // e.g. "Intro to Computer Science"
  
  institution   Institution @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  sessions      AttendanceSession[]
}

model AttendanceSession {
  id            String   @id @default(uuid())
  courseId      String
  date          DateTime @default(now())
  checkInCode   String   @unique // The randomized code (can be embedded in QR)
  isActive      Boolean  @default(true)
  
  // Geofencing data (where the class is located)
  latitude      Float?
  longitude     Float?
  radiusMeters  Float    @default(50.0)
  
  course        Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  records       AttendanceRecord[]
}

model AttendanceRecord {
  id            String   @id @default(uuid())
  sessionId     String
  studentId     String
  timestamp     DateTime @default(now())
  
  // Student's location at time of check-in
  latitude      Float?
  longitude     Float?
  
  session       AttendanceSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  student       User              @relation(fields: [studentId], references: [id], onDelete: Cascade)
  
  @@unique([sessionId, studentId]) // Prevent duplicate check-ins
}
